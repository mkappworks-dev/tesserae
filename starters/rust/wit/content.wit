package tesserae:mods@0.3.0;

/// What a Mod declares once, at load, from `declare`.
interface content {
    use types.{node-box, collision-box, connect-def, srgba};

    /// Whether a full cube of the Material hides the faces around it. Closed
    /// in 0.3: a new case is a breaking change.
    enum occlusion {
        /// Hides every neighbour's face. Requires `dimming` 15 and render class
        /// `opaque`, or the engine rejects the Material.
        opaque,
        /// Hides the faces of the same Material only.
        same-material,
        /// Hides nothing, not even itself.
        never,
    }

    /// Which mesh a Material's faces are drawn in.
    enum render-class {
        opaque,
        blend,
        cutout,
    }

    /// One Material. The engine registers it under `<mod id>:<name>` and hands
    /// the Mod its id in `start`. Colour is not here; see `appearance`.
    record material-def {
        /// The Mod's local part, `[a-z][a-z0-9_]{0,31}`.
        name: string,
        /// Block light emitted, 0 to 15.
        emission: u8,
        /// Light levels removed entering the Voxel, 0 to 15; 15 is opaque.
        dimming: u8,
        occlusion: occlusion,
        render: render-class,
        /// Whether a body collides with it and the edit ray stops on it.
        solid: bool,
        /// Hold-to-remove duration, 0.05 to 60 seconds; none uses 0.35.
        remove-time-s: option<f32>,
        /// Health a Player in Survival loses per second while their body
        /// overlaps the Material, from 0 to 1000; none is harmless.
        contact-damage-per-s: option<f32>,
        /// At most 8 labels, each `[a-z][a-z0-9-]{0,31}`. A Plant's `soil`,
        /// `stands-in` and water `fluid` may name `#<tag>` for every Material
        /// of any Mod that carries it.
        tags: list<string>,
    }

    /// One Shape. The engine registers it under `<mod id>:<name>`, derives its
    /// faces, light and collision once, and registers all 24 orientations.
    record shape-def {
        name: string,
        /// The geometry, at most 16 boxes; they may overlap.
        boxes: list<node-box>,
        /// What bodies collide with when it differs from what is drawn.
        collision: option<list<collision-box>>,
        connect: option<connect-def>,
        /// How it is drawn; none is `boxes`. `cross` and `plane` Shapes seal no
        /// face of the Voxel, are walked through unless `collision` says
        /// otherwise, cannot connect, and cost nothing against the Chunk's
        /// shaped-Voxel cap. Their boxes still decide selection and fluid.
        form: option<shape-form>,
    }

    /// How a Shape is drawn.
    enum shape-form {
        /// The boxes' faces.
        boxes,
        /// Two diagonal quads through the Voxel's centre, as a plant.
        cross,
        /// One quad along the first box's thin axis, against a face, as a vine.
        plane,
    }

    /// A placeholder colour for one of this Mod's Materials, read by the
    /// Client's flat palette until a Look pack replaces it, plus optional
    /// shared texture artwork. A Material with none is drawn magenta.
    record appearance {
        /// The Material's local name.
        material: string,
        color: srgba,
        /// Optional RGBA atlas shared by World and item rendering: 48 by 16
        /// pixels, three 16 by 16 tiles across, in top / side / bottom order.
        /// Exactly 3072 bytes; sRGB colour with straight alpha.
        texture: option<list<u8>>,
        /// How the texture varies from Voxel to Voxel. Untextured, it is ignored.
        variation: tile-variation,
    }

    /// How a Material's tile varies across its Voxels, keyed on each one's
    /// position in the World, so a wide surface does not repeat every Voxel.
    /// Closed in 0.3.
    enum tile-variation {
        /// Every Voxel draws the tile as authored: planks, brick, logs.
        fixed,
        /// Each Voxel turns or mirrors the tile. A face whose tile differs from
        /// the top's, as grass's flank does, keeps its up and only mirrors.
        turned,
        /// Turned, and patches about 5 m across shift the colour's value and hue
        /// on every face that draws the top's tile: foliage and grass.
        turned-and-patched,
    }

    /// Cave carving. The engine feeds it to native generation unchanged once
    /// validated; every distance is in metres.
    record cave-params {
        feature-size-m: f32,
        radius-m: f32,
        floor-m: f32,
        octaves: u32,
    }

    /// Smoothing of one-Voxel steps into stairs and slabs.
    record smoothing-params {
        min-rise-m: f32,
    }

    /// Standing fluid up to one height, in metres: lakes of one fluid in the
    /// valleys of the ground.
    record water-params {
        level-m: f32,
        /// A fluid, `<mod id>:<name>`, of any loaded Mod. It resolves once every
        /// Mod has declared; a name that is unknown, solid or has no fluid row
        /// fails the load.
        material: string,
    }

    /// Ground Materials by full name, resolved after every Mod has declared.
    /// Each must be a registered solid without a fluid row.
    record ground-params {
        rock: string,
        soil: string,
        surface: string,
    }

    /// Terrain generation parameters, field for field the engine's own. Only the
    /// Game may set them; the engine rejects non-finite or out-of-range values.
    /// Absent cave, smoothing, water and ground records mean none, not defaults.
    /// The engine's default has neither ground nor water; water requires ground.
    /// Server-enforced movement permissions, independent of camera view.
    record movement-policy {
        allow-flight: bool,
        allow-physics: bool,
        start-in-flight: bool,
    }

    /// Whether the Server keeps a Player's Map and the Client draws the Map, the
    /// Compass and the minimap. A saved Map is kept while this forbids it.
    record map-policy {
        enabled: bool,
    }

    /// How the engine poses a character bone. Closed in 0.3.
    enum bone-role {
        /// Turns with the body and carries what hangs from it.
        body,
        /// Follows the look's pitch, and leads its yaw while standing.
        head,
        arm-left,
        arm-right,
        leg-left,
        leg-right,
        /// Moves only with its parent.
        fixed,
    }

    /// One box of a character, in skin pixels; `pixel-m` gives their size.
    /// The figure faces -z with +y up and its feet centred on the origin.
    record character-cube {
        /// The corner with the lowest coordinates, within 64 pixels of the
        /// origin on every axis.
        origin: tuple<f32, f32, f32>,
        /// Whole pixels, 1 to 32 on each axis, so the box-UV layout is exact.
        size: tuple<u8, u8, u8>,
        /// The top-left corner of the cube's box-UV layout in the skin, laid
        /// out as a Minecraft skin is: top and bottom in the first row, then
        /// right, front, left and back. The whole layout must fit the skin.
        uv: tuple<u8, u8>,
    }

    record character-bone {
        /// `[a-z][a-z0-9_]{0,31}`, unique within the character.
        name: string,
        /// A bone declared before this one; `none` only for the first.
        parent: option<string>,
        role: bone-role,
        /// What the bone rotates about, in pixels from the origin, within 64.
        pivot: tuple<f32, f32, f32>,
        cubes: list<character-cube>,
    }

    /// How limbs move in one state of the body.
    record limb-motion {
        /// Arms and legs swing this far either way, 0 to 90; each leg swings
        /// against the arm on its side.
        swing-deg: f32,
        /// Full swings per second, 0 to 4.
        rate-hz: f32,
        /// Arms held this far forward, -90 to 180, around which they swing.
        arm-raise-deg: f32,
    }

    /// The Game's player figure, which Bedrock geometry exported from
    /// Blockbench maps onto. The Client draws it in third-person and poses it
    /// from the Server's body state; it never decides movement. At most 16
    /// bones and 16 cubes in all.
    record character-def {
        bones: list<character-bone>,
        /// Metres per skin pixel, finite and from 0.001 to 0.25, so the figure
        /// can match the body's 1.8 m.
        pixel-m: f32,
        /// 64 by 64 RGBA, sRGB with straight alpha: exactly 16384 bytes.
        skin: list<u8>,
        idle: limb-motion,
        walk: limb-motion,
        sprint: limb-motion,
        /// Off the ground in physics. Flight uses `idle`.
        airborne: limb-motion,
        crouch: limb-motion,
    }

    record world-params {
        movement: option<movement-policy>,
        /// Whether the Map and the Compass exist in this World. `none` permits them.
        /// Only the Game may set it.
        map-policy: option<map-policy>,
        /// `none` draws the engine's plain box.
        character: option<character-def>,
        sea-level-m: f32,
        relief-m: f32,
        feature-size-m: f32,
        soil-depth-m: f32,
        octaves: u32,
        caves: option<cave-params>,
        smoothing: option<smoothing-params>,
        water: option<water-params>,
        ground: option<ground-params>,
        /// How large the Climate regions are. `none` keeps the engine's default.
        /// Only the Game may set it: a `climate` from a Mod that is not the Game
        /// is a load error, like the rest of `world` beyond the character.
        climate: option<climate-params>,
        /// The fluid Generator version 3's deepest caverns hold, a fluid of any
        /// loaded Mod, `<mod id>:<name>`. `none` leaves them open. Only the Game
        /// may set it.
        lava: option<string>,
        /// Regions of Generator version 3's underground, each with its own
        /// rock, cavern floor, features and fog, at most 16. `none` leaves the
        /// underground as the surface Biomes lay it. Only the Game may set it.
        cave-biomes: option<list<cave-biome-def>>,
        /// The day and night. `none` holds the World at noon. Only the Game may
        /// set it.
        sky: option<sky-params>,
    }

    /// A World's day, by the Time of day's clock: 06:00 is always sunrise,
    /// 12:00 noon and 18:00 sunset, however the Day length is shared.
    record sky-params {
        /// Real seconds one day takes, at least 60.
        day-length-s: f32,
        /// The hour a new World starts at, from 0 up to but not including 24.
        start-hour: f32,
        /// How much of the Day length the sun is up, above 0 and below 1.
        day-share: f32,
        /// How far the sun's path leans toward the south (+Z), in degrees from
        /// 0 to 60: the noon sun stands that far from overhead.
        tilt-deg: f32,
        /// The Day curve: from 1 to 16 keys, hours ascending, eased linearly
        /// between them and across midnight. `none` is the engine's default
        /// curve.
        day-curve: option<list<day-key>>,
        /// The Cloud layer. `none` draws no clouds.
        clouds: option<cloud-layer>,
    }

    /// A slab of cloud that drifts across the sky, lit by the sun and the
    /// moon. In metres, so the same at every Voxel size.
    record cloud-layer {
        /// The slab's base, above the top of the Game's terrain band: Sea
        /// level plus the landforms' height and overhang.
        altitude-m: f32,
        /// From 1 to 200.
        thickness-m: f32,
        /// How much of the sky is cloud, from 0 to 1; a Biome's
        /// `cloud-cover` scales it.
        cover: f32,
        /// Where the clouds drift toward, in degrees clockwise from north
        /// (-Z): 90 drifts east (+X).
        wind-direction-deg: f32,
        /// From 0 to 50.
        wind-speed-m-per-s: f32,
    }

    /// How the sky looks at one hour. Colours are linear, each channel from 0
    /// to 1; strengths are shares of the engine's noon, from 0 to 1.
    record day-key {
        /// From 0 up to but not including 24, after the key before it.
        hour: f32,
        /// The sun's light while it is up; faded to nothing at the horizon
        /// whatever the curve says.
        sun: curve-light,
        /// The moon's light while the sun is down, at full moon; a thinner
        /// phase lights less.
        moon: curve-light,
        /// The light from the open sky, each colour channel times the
        /// strength at least 0.0642: a sealed cave keeps that share of noon
        /// at every hour, and open ground is never darker.
        ambient: curve-light,
        /// Move the Biome's sky and fog colours toward a colour; a Cave
        /// Biome's air is never tinted.
        sky-tint: curve-tint,
        fog-tint: curve-tint,
        /// How bright the stars are, from 0 to 1.
        stars: f32,
    }

    record curve-light {
        colour: tuple<f32, f32, f32>,
        strength: f32,
    }

    /// `amount` from 0 (the Biome's colour) to 1 (the tint's), in linear
    /// light.
    record curve-tint {
        colour: tuple<f32, f32, f32>,
        amount: f32,
    }

    /// A region of the underground, chosen where the cave Climate (two 3D
    /// fields) lies nearest its point, from 12 m under the surface down.
    record cave-biome-def {
        /// Unique among the Game's cave Biomes; the World names it
        /// `<mod id>:<name>`.
        name: string,
        /// A point in the unit square of the cave Climate.
        temperature: f32,
        humidity: f32,
        /// Metres above Sea level, negative under it; `none` matches every
        /// height.
        altitude: option<selector-range>,
        /// Solid Materials, `<mod id>:<name>`: the rock that replaces the
        /// ground's and its strata, and the Voxel under a cavern's open floor.
        /// `none` keeps the ground's.
        rock: option<string>,
        floor: option<string>,
        /// The air in its caverns; `none` keeps the surface Biome's.
        sky-fog: option<sky-fog>,
        /// At most 8.
        features: list<cave-feature>,
    }

    /// A solid Material standing on a cave Biome's dry floor, about one in
    /// every `spacing-m` by `spacing-m` metres of it, 1 to 64.
    record cave-feature {
        material: string,
        /// `none` is a cube.
        shape: option<string>,
        spacing-m: f32,
    }

    /// The size of the Climate regions, in metres: the horizontal period of the
    /// lowest octave of each field, finite and greater than zero.
    record climate-params {
        temperature-size-m: f32,
        humidity-size-m: f32,
    }

    /// How far the Client streams, in metres. Only the Game may set it; the
    /// engine rejects values outside its supported ranges.
    record view-params {
        view-distance-m: f32,
        /// The farthest a Player's Quality curve may reach: the ceiling.
        lod-distance-m: f32,
        /// The reach of the Low preset, the Game's own rings, when it is nearer
        /// than the ceiling. Absent, Low reaches `lod-distance-m`.
        low-lod-distance-m: option<f32>,
    }

    /// Exposure a hot fluid or a burning solid gives off: `strength` where it
    /// is, falling to nothing over `reach-m` of open path. Solids block it; it
    /// is not a temperature and does not conduct through them.
    record heat-def {
        /// Dimensionless, 1 to 15.
        strength: u8,
        /// Finite, positive and at most 16 m.
        reach-m: f32,
    }

    /// How one Material flows. Distances are metres and rates metres per
    /// second, so the same row runs the same fluid at any Voxel size.
    record fluid-def {
        /// A registered Material, `<mod id>:<name>`, that is not solid. It may
        /// belong to any loaded Mod; names resolve once every Mod has declared.
        material: string,
        /// How far a stream spreads sideways from where it last fell, at most
        /// 64 m.
        reach-m: f32,
        /// At most 256 m/s each.
        sideways-m-per-s: f32,
        downward-m-per-s: f32,
        /// How fast flow that lost its supply drains away.
        recession-m-per-s: f32,
        /// Gravity descent that renews `reach-m`, at most 16 m. Crossing a
        /// Voxel boundary alone renews nothing.
        reset-drop-m: f32,
        /// Whether it stands in the empty space of partial Shapes.
        waterlogs: bool,
        /// Whether it puts out burning fuel it touches, and keeps that fuel
        /// from igniting: standing in the fuel's Voxel, or across one of its
        /// faces against the solid, never through a sealed face or a
        /// partition. A hot fluid cannot extinguish.
        extinguishes: bool,
        heat: option<heat-def>,
    }

    /// Which states of a fluid a reaction matches.
    enum fluid-state {
        any,
        source,
        flowing,
    }

    record reactant {
        /// A fluid, `<mod id>:<name>`.
        fluid: string,
        state: fluid-state,
    }

    /// One participant of a reaction, by its place in it.
    enum reaction-side {
        first,
        second,
    }

    /// What two fluids do where they touch: a wet void of each meeting the
    /// other's across a face, the passage flow takes, so a sealed face or a
    /// solid partition is no contact. Declared either way round, a pair is one
    /// rule; two rules that could match one contact are a load error, and
    /// receiving sides never keep two rules apart (a level contact receives
    /// both ways). A result lands whole or not at all.
    record reaction-def {
        first: reactant,
        second: reactant,
        /// The participant whose fluid the contact removes.
        consumed: reaction-side,
        /// A solid Material placed as a cube where the consumed fluid was. Only
        /// where no solid stands: fluid waterlogging a Shape is not consumed
        /// into a product, and the contact waits until that changes.
        product: option<string>,
        /// When set, the rule matches only a contact where the other
        /// participant arrives at this one: it lies above it, or beside it on a
        /// floor no lower, where flow into it would come from; never below.
        /// Gravity alone decides, not the horizontal direction or which
        /// participant the rule names first. `none` matches any contact.
        receiving: option<reaction-side>,
    }

    /// How a fire ends.
    variant burn-end {
        /// After `seconds`, at most 1000, the solid's Material becomes
        /// `residue`, keeping its Shape; `none` removes the solid.
        after(burn-after),
        /// Never: a deliberately permanent fire.
        permanent,
    }

    record burn-after {
        seconds: f32,
        residue: option<string>,
    }

    /// How one solid Material catches fire and burns. A Material with no row
    /// never burns, whatever it looks like.
    record combustion-def {
        /// A solid Material, `<mod id>:<name>`.
        fuel: string,
        /// Exposure from 1 to 15 at or above which it starts to ignite.
        ignition-threshold: u8,
        /// Continuous exposure before it catches, from 0 to 600 s. Fuel
        /// beside terrain the World does not hold waits, keeping its progress
        /// and what is left of its burn until that terrain is held.
        ignition-delay-s: f32,
        /// Block light while it burns, 0 to 15.
        emission: u8,
        /// Exposure it gives off while it burns; `none` does not spread.
        heat: option<heat-def>,
        end: burn-end,
    }

    /// What a tool does when used. Closed: a new kind needs new engine
    /// mechanism, so it arrives with the contract line that adds it.
    enum tool-kind {
        /// Reads two corners and reports the distance between them. Edits
        /// nothing.
        measure,
        /// Places a whole Template, for a Creative Player. Use opens the list
        /// of the World's Templates and edits nothing.
        place,
    }

    /// A tool the Player can hold. The engine runs it; a Mod is never called
    /// when it is used.
    record tool-def {
        /// Local to the Mod, like a Material's; the engine adds `<mod id>:`.
        name: string,
        kind: tool-kind,
    }

    /// A Door: a size in metres, so it stands as large at every Voxel size.
    /// One Item places the whole Door, Use toggles all of it, and removing any
    /// Voxel of it removes it all and drops the closed one's Item.
    record door-def {
        /// Use swaps it with this solid Material, by full name: the open
        /// state, which bodies pass through.
        open: string,
        /// From 0.5 to 4; 1 when absent.
        width-m: option<f32>,
        /// From 1 to 4; 2 when absent.
        height-m: option<f32>,
    }

    /// What Use does to a Voxel of a Material. Closed: a new kind needs new
    /// engine mechanism, so it arrives with the contract line that adds it.
    variant voxel-use-kind {
        door(door-def),
        /// Holds Stacks of its own, in this many slots from 1 to 54; 27 when
        /// absent. Removing it while it holds any is refused to the Player, and
        /// anything else that removes it spills them as Dropped items.
        container(option<u8>),
        /// Offers the Recipes whose `station` is this tag. Materials may share
        /// a tag; `hand` is reserved.
        station(string),
    }

    /// A Material that Use acts on. The engine runs the kind; a Mod is never
    /// called when it is used.
    record voxel-use {
        /// A solid Material, by full name: a Door's closed state, or the
        /// Container.
        material: string,
        kind: voxel-use-kind,
        /// A Shape, by full name, that a Player's Place of the Material always
        /// uses whatever Shape they chose; none keeps their choice. A Door's
        /// Shape is drawn closed against its own +Z: the engine turns that to
        /// face the Player, and Use turns it a quarter about its hinge edge,
        /// the side of the cell the Player aimed at.
        shape: option<string>,
    }

    /// A thing a Player can carry. A removed Voxel of its `material` drops one;
    /// nothing else makes a drop yet.
    record item-def {
        /// Local to the Mod, like a Material's; the engine adds `<mod id>:`.
        name: string,
        /// Edge of the dropped item's cube in metres, from 0.05 to 0.5.
        size-m: f32,
        color: srgba,
        /// A solid Material, `<mod id>:<name>`, resolved after every Mod's
        /// Declaration. At most one item names a given Material.
        material: option<string>,
        /// The most one Inventory slot holds, from 1 to 64; none is 64.
        max-stack: option<u32>,
        /// Hunger eating one restores, greater than 0 and at most 1000; none
        /// is not food.
        food: option<f32>,
        /// Optional RGBA sprite, one 16 by 16 tile: exactly 1024 bytes, sRGB
        /// colour with straight alpha. An Item with one, or one whose
        /// Material's Shape is flat, is drawn as a flat sprite; none keeps the
        /// cube of `color`.
        texture: option<list<u8>>,
    }

    /// An Item, `<mod id>:<name>`, and how many.
    record recipe-stack {
        item: string,
        count: u32,
    }

    /// What one Craft spends from the Inventory and gives to it. Item names
    /// resolve after every Mod's Declaration, the implicit Item of each
    /// placeable Material included.
    record recipe-def {
        /// 1 to 9 rows, each a different Item and a count of at least 1.
        inputs: list<recipe-stack>,
        /// A count from 1 to the Item's `max-stack`.
        output: recipe-stack,
        /// `hand`, craftable anywhere, or the tag of the Station it needs.
        station: string,
    }

    /// A count from `min` to `max` inclusive, with `min` at most `max`.
    record count-range {
        min: u32,
        max: u32,
    }

    /// An Item, `<mod id>:<name>`, a removed or picked Plant Voxel gives, and
    /// how many.
    record plant-yield {
        item: string,
        count: count-range,
    }

    /// A Material one Plant passes through. Every Stage but the last has
    /// `mean-seconds`, how long it takes on average to reach the next, at least
    /// 16, in seconds at any Voxel size.
    record plant-stage {
        /// A Material, `<mod id>:<name>`, that is not a fluid.
        material: string,
        mean-seconds: option<f32>,
        yields: list<plant-yield>,
        /// The Shape this Stage's Voxels take, by full name; `none` keeps the
        /// Plant's (or a fruit's) Shape.
        shape: option<string>,
    }

    /// Fluid a Plant must have within reach to grow.
    record plant-water {
        /// A fluid Material, `<mod id>:<name>`.
        fluid: string,
        reach-m: f32,
    }

    /// What a Plant needs to grow. A Plant that fails any of it holds its Stage;
    /// none of it is ever a placement rule except `soil`.
    record plant-needs {
        /// Solid Materials, `<mod id>:<name>`, at least one: what the Plant
        /// stands on, or for a climber what it holds to.
        soil: list<string>,
        /// Light levels at the Plant's Voxel, 0 to 15; none is 0 and 15.
        light-min: option<u8>,
        light-max: option<u8>,
        /// A low and high between 0 and 1 against the Biome's Climate.
        temperature: option<tuple<f32, f32>>,
        humidity: option<tuple<f32, f32>>,
        water: option<plant-water>,
    }

    /// Fruit a vine crop's ripe Stage bears on the ground around it, as a tree
    /// bears fruit on its canopy. Fruit is grown Materials: no implicit Item and
    /// never placeable. It never seeds, so a cluster does not creep, and
    /// breaking one lets the vine bear another.
    record fruit-vine-def {
        /// 2 to 4 Stages in order; the last is ripe. Each stands on the Plant's
        /// `soil` and passes its light and Climate.
        stages: list<plant-stage>,
        /// Mean seconds between new fruit on a vine with room, at least 16.
        regrow-seconds: f32,
        /// The Shape of every fruit Voxel, by full name; `none` keeps cubes.
        shape: option<string>,
        /// How far from the vine fruit stands, above 0 and at most 8 [1.5].
        reach-m: option<f32>,
        /// Ground kept clear between two fruit, from 0 to `reach-m` [0.5]: at
        /// least one Voxel at any Voxel size, so fruit never touches.
        gap-m: option<f32>,
        /// Most fruit one vine holds within its reach, from 1 to 16 [5].
        max-fruit: option<u32>,
    }

    /// A Plant that advances through Materials in place.
    record crop-def {
        /// 2 to 8 Stages in order; the last is ripe.
        stages: list<plant-stage>,
        /// An earlier Stage, by index, that a Remove of the ripe one resets to.
        /// A vine crop has none.
        harvest-to: option<u32>,
        /// `some` makes the ripe Stage a vine that bears fruit.
        fruit-vine: option<fruit-vine-def>,
    }

    /// Fruit some canopy Voxels of a tree carry, grown Materials like the
    /// canopy.
    record fruit-def {
        /// 2 to 4 Stages in order; the last is ripe.
        stages: list<plant-stage>,
        /// The share of canopy Voxels that carry fruit, from 0 to 0.3.
        density: f32,
        /// Mean seconds between new fruit on a standing tree with room, at
        /// least 16. A canopy Voxel Samples at a mean of this times the tree's
        /// canopy Voxel count, so the tree as a whole grows one unripe fruit
        /// about this often, up to `density` of its canopy.
        regrow-seconds: f32,
        /// The Shape of every fruit Voxel, by full name, so fruit can be a box
        /// model; `none` keeps cubes.
        shape: option<string>,
    }

    /// How a tree's trunk and limbs branch, in metres and fractions of its
    /// height so the tree is the same at every Voxel size. Limbs, leaders and
    /// the trunk are the tree's trunk Material, one Voxel thick; foliage grows
    /// as lobes of the canopy Material at each limb and leader tip, and the
    /// crown on top keeps `canopy-radius-m`.
    record branching-def {
        /// Limbs per tree, at most 16; with `tiers`, rings of four limbs, at
        /// most 8 tiers. `[0, 0]` is no limbs.
        limbs: count-range,
        /// The fraction of the trunk height where limbs begin, from 0 to 0.8.
        start: f32,
        /// The horizontal length of the longest limb; a fork's leaders spread
        /// half of it. Above 0 when there are limbs or a fork.
        reach-m: f32,
        /// From -1 (drooping) to 1 (ascending): a limb's tip stands
        /// `rise * reach-m / 2` above its root.
        rise: f32,
        /// The fraction of the trunk height where it splits into two or three
        /// leaders, from 0.1 to 0.8; `none` is one trunk.
        fork: option<f32>,
        /// How far the trunk's top stands from its foot, from 0 to the lowest
        /// `trunk-height-m`.
        lean-m: f32,
        /// `some(true)` puts the limbs in rings of four that shorten towards
        /// the top, a cone.
        tiers: option<bool>,
        /// The radius of the foliage lobe at each limb and leader tip, above
        /// 0. The lean, the reach (with a fork's spread) and the lobe together
        /// stay within 8 m, and a fork's spread within the crown and lobes.
        lobe-radius-m: f32,
    }

    /// A sapling that grows a parametric tree, sized in metres.
    record tree-def {
        /// The sapling's solid Material, `<mod id>:<name>`: the seed Item places
        /// it and it grows into the tree.
        sapling: string,
        /// What removing the sapling gives.
        sapling-yields: list<plant-yield>,
        /// The tree's grown Materials, solid and `<mod id>:<name>`: made only
        /// by growth and worldgen, never placeable and named by no Item.
        trunk: string,
        /// One canopy, or up to 4 alike but for colour: each tree grows one,
        /// drawn by the World seed and where it stands.
        canopy: list<string>,
        /// Up to 4 height bands, each tree in one, drawn like its canopy.
        /// Empty is one band, `trunk-height-m` under `canopy-radius-m`.
        storeys: list<storey-def>,
        /// A low and high, above 0 and at most 32, chosen per tree.
        trunk-height-m: tuple<f32, f32>,
        /// Above 0 and at most 8.
        canopy-radius-m: f32,
        /// Seconds for the sapling to grow, at least 16.
        mean-seconds: f32,
        trunk-yield: list<plant-yield>,
        canopy-yield: list<plant-yield>,
        /// Saplings given once for every tree cut down; `min` at least 1.
        sapling-yield: count-range,
        fruit: option<fruit-def>,
        /// Climbers worldgen hangs from the outer canopy; a growing sapling
        /// never makes them. `none` hangs none.
        vines: option<tree-vines>,
        /// `none` is a straight trunk under one ellipsoidal crown.
        branching: option<branching-def>,
        /// How near, in metres, a stronger tree's trunk keeps this one from
        /// generating, above 0 and at most 12. `none` is 1.5 times
        /// `canopy-radius-m`; a dense stand declares less.
        crowding-m: option<f32>,
    }

    /// One height band of a tree. Its `branching` is the row's, its reach,
    /// lean and lobes scaled by this crown over the row's `canopy-radius-m`.
    /// Where two trees' crowns meet, the taller storey's Voxel stands.
    record storey-def {
        /// This storey's share of the row's trees, against the others';
        /// above 0.
        weight: f32,
        /// A low and high, above 0 and at most 32.
        trunk-height-m: tuple<f32, f32>,
        /// Above 0 and at most 8; `none` is the row's `canopy-radius-m`.
        canopy-radius-m: option<f32>,
    }

    /// The vines worldgen hangs from a tree, by a pure function of the tree and
    /// the World seed, so they are whole across Chunk borders and equal in
    /// metres at any Voxel size. Once placed they live by the climber's rules.
    record tree-vines {
        /// A `climber` Plant's full name, `<mod id>:<name>`, declared with a
        /// `plane` Shape and a soil list that holds this tree's canopy or trunk
        /// Material, or its vines fall at once.
        plant: string,
        /// The share of the outer canopy cells that hang one, from 0 to 0.5.
        density: f32,
        /// The longest a vine hangs, above 0 and at most 8.
        length-m: f32,
    }

    enum column-direction {
        up,
        down,
    }

    /// A Plant that grows one Voxel at a time up or down: cane, cactus, kelp.
    record column-def {
        material: string,
        /// Above 0 and at most 32.
        max-height-m: f32,
        direction: column-direction,
        mean-seconds: f32,
        /// A fluid Material, `<mod id>:<name>`, the column grows through and
        /// stands waterlogged in (kelp); `none` grows in Air (cane).
        stands-in: option<string>,
        yields: list<plant-yield>,
    }

    /// A Plant that copies itself onto a neighbouring Voxel: grass, moss,
    /// mushrooms, flowers.
    record spreader-def {
        material: string,
        /// From 1 to 8.
        reach-m: f32,
        mean-seconds: f32,
        /// At most this many of its Voxels within `reach-m`, at least 1.
        density: u32,
        /// Seeds a target only where at least this many of its Voxels stand
        /// within `reach-m` of it, the seeding one included, so a patch fills
        /// its holes and does not advance. A count of Voxels, like `density`,
        /// and below it. A Voxel with none of its kind within its own reach is
        /// exempt, so a lone planted seed still grows a neighbour. `none` and
        /// 1 set no rule [0].
        min-neighbours: option<u32>,
        yields: list<plant-yield>,
    }

    /// A Plant that grows along the faces of solids: vines.
    record climber-def {
        material: string,
        mean-seconds: f32,
        /// Above 0 and at most 32.
        length-m: f32,
        yields: list<plant-yield>,
    }

    variant plant-kind {
        crop(crop-def),
        tree(tree-def),
        column(column-def),
        spreader(spreader-def),
        climber(climber-def),
    }

    /// A Plant the Server grows. Names resolve after every Mod has declared;
    /// the Seed Item places the first Stage.
    record plant-def {
        /// Local to the Mod, like a Material's; the engine adds `<mod id>:`.
        name: string,
        /// An Item, `<mod id>:<name>`, whose Material is the Plant's first
        /// Stage, a tree's sapling, or the one Material of any other kind.
        seed: string,
        /// The Shape of every single-Voxel Stage (crop Stages, a sapling, a
        /// column, spreader or climber Voxel), by full name. Placing the seed,
        /// growth and generation all use it, whatever the Player chose; `none`
        /// keeps the Player's choice and cubes.
        shape: option<string>,
        needs: plant-needs,
        kind: plant-kind,
    }

    /// The rules of Survival, from the Game only. Every field is optional and
    /// an absent one takes the engine's default, shown in brackets. Health and
    /// hunger are points, distances metres and times seconds.
    record survival-params {
        /// 1 to 1000 [20].
        max-health: option<f32>,
        /// 1 to 1000 [20].
        max-hunger: option<f32>,
        /// Seconds of breath under a fluid's surface, 1 to 600 [10].
        max-air-s: option<f32>,
        /// A fall up to this height costs nothing, 0 to 1000 [3].
        safe-fall-m: option<f32>,
        /// Health lost per metre fallen beyond `safe-fall-m`, 0 to 1000 [1].
        fall-damage-per-m: option<f32>,
        /// Health lost per second with no air left, 0 to 1000 [2].
        drowning-damage-per-s: option<f32>,
        /// Hunger lost per minute, 0 to 1000 [1].
        hunger-per-min: option<f32>,
        /// Hunger lost per minute while sprinting, 0 to 1000 [2].
        sprinting-hunger-per-min: option<f32>,
        /// Health regenerates while hunger is at least this, 0 to
        /// `max-hunger` [18].
        regeneration-hunger: option<f32>,
        /// Health lost per second at zero hunger, 0 to 1000 [0.25].
        starvation-damage-per-s: option<f32>,
        /// Whether a dead Player keeps their Inventory instead of dropping it
        /// [false].
        keep-inventory: option<bool>,
        /// Health regained per second while hunger is at least
        /// `regeneration-hunger`, 0 to 1000 [0.25].
        regeneration-per-s: option<f32>,
    }

    /// A kind of ground: a point in the unit square of Climate, where the
    /// nearest point to a column wins it.
    record biome-def {
        /// Local to the Mod, like a Material's; the engine adds `<mod id>:`, and
        /// the whole name is at most 32 bytes.
        name: string,
        /// Both from 0 to 1.
        temperature: f32,
        humidity: f32,

        /// The ground this Biome's columns are made of. `none` uses the Game's
        /// `world.ground`. Switches hard at the Biome's border.
        ground: option<ground-params>,

        /// The sky and fog colours over this Biome, easing as the Player walks
        /// between Biomes. `none` leaves the Biome out of the blend.
        sky-fog: option<sky-fog>,

        /// A multiplier on the Game's cave radius in this Biome, from 0 to 4:
        /// `none` and 1 leave the caves as they are, 0 switches them off. It
        /// blends smoothly across the Biome's border, unlike `ground`.
        cave-scale: option<f32>,

        /// A multiplier on the Game's cloud cover over this Biome, from 0 to 4;
        /// the cover shown is at most 1. `none` is 1. It blends across the
        /// Biome's border like `sky-fog`.
        cloud-cover: option<f32>,

        /// At most 16 Materials or Plants the engine stands one Voxel above this
        /// Biome's surface Material, where the column's top is a full Voxel of it
        /// with air above: never under a fluid, on a smoothed step or in a cave
        /// mouth. Distance levels leave them out.
        surface-features: list<surface-feature>,
        /// At most 2 planted fields: rectangular plots of one crop in rows, with
        /// paths between them and a ditch, over this Biome's ground. Empty
        /// stands none.
        crop-fields: list<crop-field>,
        /// At most 4 Templates world generation stands in this Biome as
        /// Structures. Empty stands none.
        structures: list<biome-structure>,
        /// At most 2 Settlements world generation lays out in this Biome. Empty
        /// lays out none.
        settlements: list<biome-settlement>,
        /// What the chests of wilderness Structures standing in this Biome
        /// hold; `none` leaves them empty.
        loot: option<loot-table>,
        /// Optional Soundscape full name, resolved across loaded Mods.
        soundscape: option<string>,
        /// Where this Biome may stand beyond its Climate, and how rough its
        /// landform is, under Generator version 3 only. `none` matches every
        /// altitude, coast and erosion and leaves relief alone.
        selectors: option<biome-selectors>,
        /// Layers of rock by depth below the surface, under Generator version
        /// 3 only, at most 8. The first that holds a depth wins; the Biome's
        /// rock fills the rest. `none` is plain rock under the soil.
        strata: option<list<biome-stratum>>,
    }

    /// A layer of a Biome's rock from `depth-min-m` to `depth-max-m` below
    /// the surface, at most 96 m down. Its edges undulate a few metres.
    record biome-stratum {
        /// A solid Material, `<mod id>:<name>`.
        material: string,
        depth-min-m: f32,
        depth-max-m: f32,
    }

    /// An inclusive range; `min` is at most `max`.
    record selector-range {
        min: f32,
        max: f32,
    }

    /// A Biome's place in the land. A range left `none` matches every value
    /// on that axis, so a Biome declared before version 3 is unchanged. When
    /// Biomes tie in Climate the earlier one wins, so list a specific Biome
    /// before the general one it sits inside.
    record biome-selectors {
        /// Metres above Sea level; negative is under the sea.
        altitude: option<selector-range>,
        /// Metres inland of the coast; negative is offshore.
        coast: option<selector-range>,
        /// 0 rugged to 1 worn flat.
        erosion: option<selector-range>,
        /// Metres a river's valley cuts the ground: 0 away from rivers,
        /// most in a riverbed.
        river: option<selector-range>,
        /// Multiplies the detail relief of the Biome's landform, 0 to 4. It
        /// blends smoothly across the Biome's border.
        relief: option<f32>,
    }

    /// A Material or a Plant scattered over a Biome's surface, deterministically
    /// from the World seed. Removing a Material feature drops its Item as any
    /// Voxel does. Exactly one of `material` and `plant` is set.
    record surface-feature {
        /// A solid Material, `<mod id>:<name>`, resolved after every Mod's
        /// Declaration.
        material: option<string>,
        /// A Plant, `<mod id>:<name>`, from any loaded Mod. A `crop` or
        /// `spreader` stands at a Stage drawn by hash; a `column` stands on the
        /// ground, or in the lake when it declares `stands-in`; a `tree` stands
        /// fully grown, and its trunk and canopy may reach into neighbouring
        /// Chunks. A `climber` is refused, and so is a column growing down. The
        /// World freezes what generation needs of the Plant when it is made, so
        /// a later change to the Plant never reshapes it.
        plant: option<string>,
        /// With `plant`: the Shape, `<mod id>:<name>`, of a crop's, spreader's
        /// or column's Voxels, as a Player's Place would have chosen it; none
        /// is a cube. A tree is always cubes.
        shape: option<string>,
        /// About one in every `spacing-m` by `spacing-m` metres of the Biome's
        /// surface, at any Voxel size; from 1 to 1024.
        spacing-m: f32,
        /// Gathers the feature into groves with clearings between, still `spacing-m`
        /// apart on average; none scatters it evenly.
        clump: option<clump>,
        /// Groups the feature with the others of the Biome that share its
        /// `group`, so a region of ground holds mostly one of them; none stands
        /// wherever it is drawn.
        field: option<field-def>,
    }

    /// Makes a group of a Biome's features compete by region: a lattice
    /// `scale-m` apart, moved by hash, cuts the ground into regions, each given
    /// one member of the group by hash. A column that draws a member stands it
    /// only in a region that holds it, or, with chance `strays`, anywhere. A
    /// pure function of the World seed and a position in metres, so it holds
    /// across Chunk borders and at every Voxel size. A member stands in a
    /// share of the ground, so a group is thinner than its spacings say: tune
    /// the spacing for the share.
    record field-def {
        /// Local to the Biome: features with the same name compete. Every
        /// member gives the same `scale-m` and `strays`.
        group: string,
        /// The width of a region, from 8 to 96 m.
        scale-m: f32,
        /// The share of columns that ignore their region, from 0 to 0.5.
        strays: f32,
    }

    /// A planted field: a lattice cell `spacing-m` on a side draws whether it
    /// holds a field, which is a small grid of plots, each one crop planted
    /// every second row (ripe, or at a hash-drawn Stage), set apart by lanes one
    /// Voxel wide that also ring the field. The lane along the field's lowest
    /// edge is the ditch, cut into the ground and filled; the others are the
    /// path. A field stands only on ground level within a metre and wholly in
    /// its Biome, clear of the lake, caves and trees: a drawn field that would
    /// not is skipped whole. A pure function of the World seed, the Voxel size
    /// and positions in metres, so it holds across Chunk borders. At most 2 per
    /// Biome; a later one is dropped where it would cross an earlier.
    record crop-field {
        /// 1 to 4 crop Plants, `<mod id>:<name>`, with weights above 0 that
        /// say how often each is drawn for a plot. A `crop` without
        /// `fruit-vine`, with at most 8 Stages.
        crops: list<tuple<string, f32>>,
        /// A plot's side is drawn from this range, each from 6 to 24 m, low
        /// first.
        plot-m: tuple<f32, f32>,
        /// The mean distance between fields, from 32 to 256 m.
        spacing-m: f32,
        /// A solid Material, `<mod id>:<name>`, the lanes are laid in; none
        /// leaves them bare.
        path: option<string>,
        /// A fluid Material, `<mod id>:<name>`, the ditch is filled with; none
        /// cuts no ditch.
        ditch: option<string>,
        /// The field stands only where the lake is within this many metres of
        /// its centre, above 0 and at most `spacing-m`; none is anywhere. A
        /// World without a lake has none.
        near-water-m: option<f32>,
    }

    /// A Template a Biome stands as a Structure: each square of a lattice
    /// `spacing-m` on a side holds one with `chance`, turned by quarter turns
    /// and inset so two never touch. Where, how turned and how high is a pure
    /// function of the World seed and positions in metres, so a Structure is
    /// whole across Chunk borders and the same at every Voxel size. Its cells
    /// overwrite the ground, Air included; `keep` cells leave it.
    record biome-structure {
        /// A Template, `<mod id>:<name>`, from any loaded Mod.
        template: string,
        /// At least twice the Template's longer side, at most 4096 m.
        spacing-m: f32,
        /// Above 0 and at most 1.
        chance: f32,
    }

    /// A Settlement a Biome lays out: each square of a lattice `spacing-m` on
    /// a side draws a centre anywhere in it with `chance`, which stands unless
    /// a neighbouring square's draw would meet its disc and margin, and where
    /// the ground at its centre takes it. Its layout is a pure function of the
    /// World seed and the square, so it is whole across Chunk borders and the
    /// same at every Voxel size. It claims ground before single Structures,
    /// crop fields, trees and scatter.
    record biome-settlement {
        /// A Settlement, `<mod id>:<name>`, from any loaded Mod.
        settlement: string,
        /// At least twice the Settlement's radius and margin, at most 4096 m.
        spacing-m: f32,
        /// Above 0 and at most 1.
        chance: f32,
        /// The four squares round the origin always draw a centre, clear of
        /// the spawn's keep-out, and win against their neighbours, so a
        /// Player finds this Settlement near spawn where the ground takes it.
        near-spawn: bool,
    }

    /// A low-frequency density field over the ground, in metres, that multiplies
    /// a feature's chance. A pure function of the World seed and a position, so
    /// it holds across Chunk borders and at every Voxel size.
    record clump {
        /// The distance over which the density varies, from 4 to 1024 m: a
        /// grove's width.
        scale-m: f32,
        /// From 0 (even) to 1: 0.6 is groves at up to 1.6 times the density
        /// with thin clearings, 0.95 patches over a fifth of the ground at up
        /// to 5 times with bare ground between, and 1 nothing between patches.
        strength: f32,
    }

    /// A sky colour and the fog that matches it, as sRGB bytes. A pair, so a
    /// Biome gives both or neither. `sky` is the colour behind the terrain; `fog`
    /// is what distant terrain fades toward, a little lighter than `sky`.
    record sky-fog {
        sky: tuple<u8, u8, u8>,
        fog: tuple<u8, u8, u8>,
    }

    /// A vein of one Material in the rock, centred within a band of depth
    /// below the surface.
    record ore-def {
        /// A solid Material, `<mod id>:<name>`, resolved after every Mod's
        /// Declaration.
        material: string,
        /// The band, in metres below the surface, shallow end first; both from
        /// 0 to 65536.
        min-depth-m: f32,
        max-depth-m: f32,
        /// Finite and greater than zero.
        vein-size-m: f32,
        /// Greater than 0 and at most 1.
        rarity: f32,
        /// Biomes, `<mod id>:<name>`, from any loaded Mod. Empty is every Biome.
        biomes: list<string>,
    }

    /// Which of a user's volume settings a Sound is heard under, all under
    /// Master. Closed in 0.3: a new case is a breaking change.
    enum sound-category {
        /// Positional: heard from where it happens, so every recording must be
        /// mono.
        effects,
        /// Not positional; may be stereo.
        ambient,
        /// Not positional; may be stereo.
        music,
    }

    /// One Ogg Vorbis file a Sound may play.
    record recording {
        /// The whole file. The engine reads its Ogg and Vorbis identification
        /// headers and refuses one that is not Ogg Vorbis.
        bytes: list<u8>,
        /// How often it is chosen against the Sound's other recordings.
        weight: u8,
    }

    /// An inclusive range a value is drawn from each time a Sound plays.
    record sound-range {
        min: f32,
        max: f32,
    }

    /// How far an Effects Sound carries, in metres: whole within
    /// `reference-m`, falling beyond it and silent from `max-m`, which must be
    /// greater.
    record sound-distance {
        reference-m: f32,
        max-m: f32,
    }

    /// A thing that can be heard. The engine registers it under
    /// `<mod id>:<name>`.
    record sound-def {
        /// Local to the Mod, like a Material's.
        name: string,
        /// At least one; one is picked by weight each time it plays.
        recordings: list<recording>,
        volume: sound-range,
        /// A playback speed: 2 is an octave up.
        pitch: sound-range,
        category: sound-category,
        /// Required for `effects` and refused for the others.
        distance: option<sound-distance>,
    }

    /// What one or more Materials sound like for each Voxel Cause, each an
    /// `effects` Sound by full name, `<mod id>:<name>`, from any loaded Mod.
    /// A Cause left out is silent.
    record sound-set-def {
        /// Local to the Mod, like a Material's.
        name: string,
        /// A deliberate Remove takes the Voxel out of the World.
        %break: option<string>,
        place: option<string>,
        hit: option<string>,
        step: option<string>,
        land: option<string>,
    }

    /// Gives a Material a Sound set. A Material has at most one in a World,
    /// whichever Mods declare them.
    record material-sound {
        /// A Material, `<mod id>:<name>`, of any loaded Mod.
        material: string,
        /// A Sound set, `<mod id>:<name>`, of any loaded Mod.
        sound-set: string,
    }

    /// Where the Player's Eye is, for choosing the Game's Soundscape. Closed in
    /// 0.3: a new case is a breaking change.
    enum soundscape-context {
        /// Anywhere the other contexts are not.
        %default,
        /// The Eye's Voxel receives no sky light.
        underground,
        /// The Eye is inside a fluid.
        underwater,
    }

    /// The hours an ambient bed is heard at. Closed in 0.3.
    enum bed-hours {
        /// Scaled by Daylight: whole by day, silent by night.
        day,
        /// Scaled by one minus Daylight, so it crossfades with the day beds.
        night,
        /// At every hour.
        always,
    }

    /// An ambient loop a Soundscape plays for as long as it applies.
    record ambient-bed {
        /// An `ambient` Sound, `<mod id>:<name>`, of any loaded Mod.
        sound: string,
        /// From 0 to 1, on top of the Sound's own volume.
        volume: f32,
        /// `none` is `always`.
        when: option<bed-hours>,
    }

    /// The ambience and music heard where it applies. The engine registers it
    /// under `<mod id>:<name>`.
    record soundscape-def {
        /// Local to the Mod, like a Material's.
        name: string,
        /// Only the Game's Soundscapes may carry one, at most one per context.
        /// A Mod's exists to be named by a Biome.
        context: option<soundscape-context>,
        /// At most 8, each looped.
        beds: list<ambient-bed>,
        /// At most 8 `music` Sounds by full name; one plays now and then, never
        /// the one just heard while there are two or more.
        music: list<string>,
        /// The silence before each track, in seconds, drawn from 0 to 3600
        /// [60 to 180].
        silence-s: option<sound-range>,
        /// At most 8 `music` Sounds by full name. When set, a track starts from
        /// `music` while Daylight is at least 0.5 and from these otherwise; a
        /// playing track is never cut by the hour. `none` plays `music` at
        /// every hour.
        night-music: option<list<string>>,
    }

    /// Why the Server makes a Sound event that is not a Voxel's. Closed in
    /// 0.3: a new case needs new engine mechanism, so it arrives with a
    /// contract change.
    enum sound-cause {
        /// The body enters or leaves a cold fluid.
        splash,
        /// An Item joins the Inventory.
        pickup,
        /// A Use measured something.
        use-measured,
        /// A Use was refused, eating included.
        use-refused,
        /// Food is eaten.
        eat,
        /// A Player takes damage, whatever its cause.
        hurt,
        /// A Player dies.
        death,
        /// A swimming stroke, measured by distance travelled.
        swimming,
        /// Gentle movement while floating at the surface.
        floating,
        /// The body enters a heat-emitting fluid.
        burn,
        /// A Door opens, heard at the Door.
        door-open,
        /// A Door closes, heard at the Door.
        door-close,
        /// A Player opens a Container, heard at the Container.
        container-open,
        /// A Player's Container session ends with the Container still there,
        /// heard at the Container.
        container-close,
        /// A Craft lands, heard at the Player.
        craft,
    }

    /// Binds a non-Voxel Cause to an `effects` Sound. A Cause left unbound is
    /// silent.
    record cause-sound {
        cause: sound-cause,
        /// A Sound, `<mod id>:<name>`, of any loaded Mod.
        sound: string,
    }

    /// What the Engine draws a Marker kind as: a closed set of shapes, so no
    /// font has to carry an icon.
    enum marker-icon {
        home,
        camp,
        mine,
        farm,
        landmark,
        death,
        flag,
        pin,
        star,
    }

    /// A kind of mark a Player can put on the Map and the Compass.
    record marker-kind-def {
        /// The kind's local name.
        name: string,
        icon: marker-icon,
        color: srgba,
    }

    /// A Voxel one palette character of a Template stands for.
    record template-voxel {
        /// A Material, `<mod id>:<name>`, that is not a fluid.
        material: string,
        /// A Shape, `<mod id>:<name>`; none is `core:cube`.
        shape: option<string>,
        /// One of the 24 orientations, as a Voxel's orientation byte; none is 0.
        orientation: option<u8>,
    }

    /// What one palette character of a Template stands for.
    variant template-cell {
        /// Never written: the ground a Structure stands in shows through.
        keep,
        /// Written as air, so it carves.
        air,
        voxel(template-voxel),
        /// The ground where the Structure stands: its column's Biome's surface
        /// Material at and above the ground layer, its soil below.
        ground,
    }

    record template-palette-entry {
        symbol: char,
        cell: template-cell,
    }

    /// A block of Voxels on a grid whose cell size is in metres, which a World
    /// samples at its own Voxel size and turns in quarter turns.
    record template-def {
        /// The Template's local name; the engine adds `<mod id>:`.
        name: string,
        /// Every cell's edge, above 0 metres. A side is at most 64 metres and a
        /// Template at most 65,536 cells.
        cell-m: f32,
        palette: list<template-palette-entry>,
        /// From the bottom up. A layer is rows running +Z, a row characters
        /// running +X; every layer has the same rows and every row the same
        /// length, and every character is in the palette.
        layers: list<list<string>>,
        /// The layer that sits at ground height, counted from 0 at the bottom;
        /// the layers below it are underground. Required: none is a load error.
        ground-layer: option<u32>,
        /// A Material, `<mod id>:<name>`, that is not a fluid, filling beneath
        /// the lowest layer down to uneven ground.
        foundation: option<string>,
        /// How far the ground under the footprint may vary, 0 to 16 metres;
        /// none is 1.
        level-tolerance-m: option<f32>,
        /// Stands only where its longer side, at least 6 metres, crosses a gap,
        /// a valley or water, from a dry 2 metre landing at one end to one at
        /// the other. No Settlement may draw it.
        spans: bool,
    }

    /// A Template a Settlement draws its Plots from.
    record settlement-plot {
        /// A Template, `<mod id>:<name>`, from any loaded Mod. Its door, the
        /// first Door cell from its Ground layer up, faces the road.
        template: string,
        /// Above 0: how often it is drawn against the others.
        weight: f32,
        /// At least this many stand, or the Settlement is dropped.
        min: u8,
        /// At most this many stand.
        max: u8,
        /// What this Template's chests hold, in place of the Settlement's
        /// `loot`.
        loot: option<loot-table>,
    }

    /// A hamlet, village or town world generation lays out: roads branch from
    /// its centre along gentle ground, forking part-way once its radius reaches
    /// 66 metres, and Plots grow beside them, each Structure turned so its door
    /// faces the road. Each copy draws its size from the World seed and its
    /// lattice square: its most Plots evenly from `plots-min` to `plots`, and
    /// its radius from `radius-min-m` to `radius-m` following them.
    record settlement-def {
        /// The Settlement's local name; the engine adds `<mod id>:`.
        name: string,
        /// The largest copy's radius, above 0 and at most 160 metres.
        radius-m: f32,
        /// The smallest copy's radius, above 0 and at most `radius-m`; none is
        /// `radius-m`. No Template it names is wider.
        radius-min-m: option<f32>,
        /// How far past its disc single Structures keep out, 0 to 64 metres;
        /// none is 16.
        margin-m: option<f32>,
        /// A Template, `<mod id>:<name>`, that stands at its centre.
        centre: option<string>,
        /// How many Plots the largest copy lays at most besides its centre, at
        /// most 96.
        plots: u8,
        /// How many Plots the smallest copy lays at most, at most `plots`; none
        /// is `plots`.
        plots-min: option<u8>,
        /// From 1 to 96 rows; their minimums add up to at most `plots-min`.
        templates: list<settlement-plot>,
        /// Fewer Plots than this, besides its centre, and it is dropped; at
        /// most `plots-min`.
        minimum: u8,
        /// A Material, `<mod id>:<name>`, that is not a fluid, its roads are
        /// laid in.
        path: string,
        /// A Shape, `<mod id>:<name>`, its roads take on level ground; none is
        /// `core:cube`.
        path-shape: option<string>,
        /// What its buildings' chests hold, unless a Template's row gives its
        /// own; `none` leaves them empty.
        loot: option<loot-table>,
        /// Groups of Buildings laid beside its approach paths just past its
        /// disc, inside its margin, in order, each by its own chance: fields,
        /// orchards and paddocks in one, ponds in another. At most 4. `none`
        /// lays none.
        outskirts: option<list<settlement-outskirts>>,
    }

    /// What a Settlement lays past its disc, drawn like its Plots.
    record settlement-outskirts {
        /// Up to 96 rows. Each Template's longer side is at most the
        /// Settlement's margin.
        templates: list<settlement-plot>,
        /// How many a copy lays at most, drawn from `count-min` to
        /// `count-max`, at most 96.
        count-min: u8,
        count-max: u8,
        /// The share of copies that lay any, above 0 and at most 1; every
        /// copy when absent. A copy that cannot stand `count-min` lays none.
        chance: option<f32>,
    }

    /// What a chest world generation stands holds, drawn the first time a
    /// Container is needed for it: opened, or broken. The draw is a pure
    /// function of the World seed, the chest's place in its Structure and the
    /// table, so it is the same whenever it happens and at every Voxel size.
    /// A chest a Player places, or the `place` Tool stands, starts empty.
    record loot-table {
        /// How many Stacks it draws, from `rolls-min` to `rolls-max`, at most
        /// 27; each a Slot of its own, and a draw past the last free Slot is
        /// dropped.
        rolls-min: u8,
        rolls-max: u8,
        /// From 1 to 16 entries.
        entries: list<loot-entry>,
    }

    /// One thing a loot table may draw.
    record loot-entry {
        /// An Item, `<mod id>:<name>`, from any loaded Mod. It need not be
        /// Obtainable another way: loot is a source.
        item: string,
        /// A Stack of `min` to `max`, with `min` at least 1 and `max` at most
        /// the Item's `max-stack`.
        min: u32,
        max: u32,
        /// Above 0: how often it is drawn against the others.
        weight: f32,
    }

    /// Everything a Mod adds, in registration order: a name's id is its index
    /// after the engine's built-ins, so Materials start at 8 (7 is retired and
    /// never handed out) and Shapes at 4. A `world` or `view` from a Mod that is
    /// not the Game is a load error, not ignored.
    ///
    /// `fluids`, `reactions` and `combustion` name Materials by full name and
    /// are resolved after every Mod's Declaration and before the World opens;
    /// an unknown name or a value out of range fails the load.
    record declaration {
        materials: list<material-def>,
        shapes: list<shape-def>,
        /// At most 128 rows; texture pixel lengths are validated before use.
        appearance: list<appearance>,
        /// `none` keeps the engine's default; `some` replaces it whole.
        %world: option<world-params>,
        view: option<view-params>,
        fluids: list<fluid-def>,
        reactions: list<reaction-def>,
        combustion: list<combustion-def>,
        /// At most 8 rows, from the Game only: a `tools` from a Mod that is not
        /// the Game is a load error, like `world` and `view`.
        tools: list<tool-def>,
        /// At most 64 rows per Mod and 256 in a World, from any Mod.
        items: list<item-def>,
        /// At most 16 rows per Mod and 16 in a World, from any Mod. A Biome's id
        /// is its place in load order, so a Mod only ever appends. Climate comes
        /// from the Game's `world`.
        biomes: list<biome-def>,
        /// At most 16 rows per Mod and 32 in a World, from any Mod.
        ores: list<ore-def>,
        /// From the Game only, like `view`; `none` keeps every default.
        survival: option<survival-params>,
        /// From any Mod. Names in `sound-sets` and `material-sounds` resolve
        /// after every Mod has declared.
        sounds: list<sound-def>,
        sound-sets: list<sound-set-def>,
        material-sounds: list<material-sound>,
        /// At most 16 rows per Mod, from any Mod; a `context` only from the
        /// Game. Names resolve after every Mod has declared.
        soundscapes: list<soundscape-def>,
        /// From the Game only, like `tools`; each Cause at most once.
        cause-sounds: list<cause-sound>,
        /// At most 256 rows per Mod and 1024 in a World, from any Mod. Names
        /// resolve after every Mod has declared.
        recipes: list<recipe-def>,
        /// At most 64 rows per Mod, from any Mod. Names resolve after every Mod
        /// has declared; a Material is in at most one row, as its `material` or
        /// as a Door's open one.
        voxel-uses: list<voxel-use>,
        /// At most 128 rows per Mod and 512 in a World, from any Mod. A Material
        /// is in at most one Plant, once.
        plants: list<plant-def>,
        /// At most 16 rows per Mod, from any Mod, named `<mod id>:<name>`.
        marker-kinds: list<marker-kind-def>,
        /// The full name of the Marker kind a death leaves, from the Game only;
        /// it must name a declared Marker kind. `none` leaves no death mark.
        death-marker-kind: option<string>,
        /// At most 64 in a World, from any Mod, named `<mod id>:<name>`. Names
        /// resolve after every Mod has declared.
        templates: list<template-def>,
        /// At most 16 in a World, from any Mod, named `<mod id>:<name>`. Names
        /// resolve after every Mod has declared.
        settlements: list<settlement-def>,
    }
}

+// [DEBUG-t34] temporary instrumentation, reverted before finishing.
+mod t34 {
+    use std::alloc::{GlobalAlloc, Layout, System};
+    use std::sync::atomic::{AtomicI64, AtomicU64, Ordering::Relaxed};
+
+    pub static LIVE: AtomicI64 = AtomicI64::new(0);
+    pub static COUNT: AtomicU64 = AtomicU64::new(0);
+
+    pub struct Counting;
+    unsafe impl GlobalAlloc for Counting {
+        unsafe fn alloc(&self, l: Layout) -> *mut u8 {
+            LIVE.fetch_add(l.size() as i64, Relaxed);
+            COUNT.fetch_add(1, Relaxed);
+            unsafe { System.alloc(l) }
+        }
+        unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
+            LIVE.fetch_sub(l.size() as i64, Relaxed);
+            unsafe { System.dealloc(p, l) }
+        }
+        unsafe fn alloc_zeroed(&self, l: Layout) -> *mut u8 {
+            LIVE.fetch_add(l.size() as i64, Relaxed);
+            COUNT.fetch_add(1, Relaxed);
+            unsafe { System.alloc_zeroed(l) }
+        }
+        unsafe fn realloc(&self, p: *mut u8, l: Layout, n: usize) -> *mut u8 {
+            LIVE.fetch_add(n as i64 - l.size() as i64, Relaxed);
+            COUNT.fetch_add(1, Relaxed);
+            unsafe { System.realloc(p, l, n) }
+        }
+    }
+
+    #[repr(C)]
+    #[derive(Default)]
+    struct MallocStats {
+        blocks: u32,
+        in_use: usize,
+        max_in_use: usize,
+        allocated: usize,
+    }
+    unsafe extern "C" {
+        fn malloc_zone_statistics(zone: *mut std::ffi::c_void, stats: *mut MallocStats);
+        fn malloc_zone_pressure_relief(zone: *mut std::ffi::c_void, goal: usize) -> usize;
+    }
+
+    pub fn rss_mb() -> u64 {
+        std::process::Command::new("ps")
+            .args(["-o", "rss=", "-p", &std::process::id().to_string()])
+            .output()
+            .ok()
+            .and_then(|o| String::from_utf8(o.stdout).ok())
+            .and_then(|s| s.trim().parse::<u64>().ok())
+            .unwrap_or(0)
+            / 1024
+    }
+
+    pub fn line(tag: &str) {
+        if std::env::var_os("T34_RELIEF").is_some() {
+            let before = rss_mb();
+            let freed = unsafe { malloc_zone_pressure_relief(std::ptr::null_mut(), 0) };
+            eprintln!(
+                "[DEBUG-t34] {tag} relief rss_before_mb={before} rss_after_mb={} freed_mb={}",
+                rss_mb(),
+                freed / 1048576
+            );
+        }
+        let mut st = MallocStats::default();
+        unsafe { malloc_zone_statistics(std::ptr::null_mut(), &mut st) };
+        let mb = |b: usize| b as f64 / 1048576.0;
+        eprintln!(
+            "[DEBUG-t34] {tag} rust_live_mb={:.1} rust_allocs={} malloc_in_use_mb={:.1} malloc_zone_allocated_mb={:.1} blocks={}",
+            LIVE.load(Relaxed) as f64 / 1048576.0,
+            COUNT.load(Relaxed),
+            mb(st.in_use),
+            mb(st.allocated),
+            st.blocks,
+        );
+        if let Some(dir) = std::env::var_os("T34_OUT") {
+            let pid = std::process::id().to_string();
+            let dir = std::path::PathBuf::from(dir);
+            let heavy = std::env::var("T34_HEAP")
+                .is_ok_and(|list| list.split(',').any(|c| tag == format!("cycle{:03}", c.parse::<u32>().unwrap_or(9999))));
+            let mut tools = if std::env::var_os("T34_NOVMMAP").is_some() { vec![] } else { vec![("vmmap", vec!["-summary"]), ("footprint", vec![])] };
+            if heavy {
+                tools.push(("heap", vec!["-sortBySize"]));
+                if std::env::var_os("T34_NOVMMAP").is_none() { tools.push(("leaks", vec![])); }
+                if std::env::var_os("MallocStackLogging").is_some() {
+                    tools.push(("malloc_history", vec!["PID", "-allBySize"]));
+                }
+            }
+            for (tool, args) in tools {
+                let mut cmd = std::process::Command::new(tool);
+                if args.contains(&"PID") {
+                    cmd.args(args.iter().map(|a| if *a == "PID" { pid.as_str() } else { a }));
+                } else {
+                    cmd.args(&args).arg(&pid);
+                }
+                let out = cmd.output();
+                if let Ok(out) = out {
+                    let _ = std::fs::write(dir.join(format!("{tool}-{tag}.txt")), out.stdout);
+                }
+            }
+        }
+    }
+}

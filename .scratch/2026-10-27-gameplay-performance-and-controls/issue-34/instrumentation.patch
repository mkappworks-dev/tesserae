@@ -0,0 +1,62 @@
+// [DEBUG-t34] throwaway: Mod load and drop in a loop, outside Bevy.
+use std::path::PathBuf;
+use tesserae_mods::{ModHost, Trust, discover, plan};
+
+#[repr(C)]
+#[derive(Default)]
+struct Stats {
+    blocks: u32,
+    in_use: usize,
+    max: usize,
+    allocated: usize,
+}
+unsafe extern "C" {
+    fn malloc_zone_statistics(zone: *mut std::ffi::c_void, s: *mut Stats);
+}
+
+fn rss_mb() -> u64 {
+    let out = std::process::Command::new("ps")
+        .args(["-o", "rss=", "-p", &std::process::id().to_string()])
+        .output()
+        .unwrap();
+    String::from_utf8(out.stdout).unwrap().trim().parse::<u64>().unwrap() / 1024
+}
+
+fn main() {
+    let mut args = std::env::args().skip(1);
+    let dir = PathBuf::from(args.next().unwrap());
+    let mode = args.next().unwrap();
+    let n: u32 = args.next().unwrap().parse().unwrap();
+    let trust_file = std::env::temp_dir().join(format!("t34-trust-{}.json", std::process::id()));
+    for i in 0..=n {
+        match mode.as_str() {
+            "engine" => drop(ModHost::new().unwrap()),
+            _ => {
+                let found = plan(discover(&dir).unwrap()).unwrap();
+                let mut trust = Trust::load(&trust_file);
+                for f in &found {
+                    trust.grant_for_run(f).unwrap();
+                }
+                let host = ModHost::new().unwrap();
+                let compiled = host.load(found, &trust).unwrap();
+                if mode == "full" {
+                    futures_lite::future::block_on(async {
+                        for c in &compiled {
+                            let inst = host.instantiate(c, 1).await.unwrap();
+                            let (inst, _decl) = inst.declare().await.unwrap();
+                            drop(inst);
+                        }
+                    });
+                }
+            }
+        }
+        let mut s = Stats::default();
+        unsafe { malloc_zone_statistics(std::ptr::null_mut(), &mut s) };
+        println!(
+            "{mode} {i} rss_mb={} in_use_mb={:.1} zone_mb={:.1}",
+            rss_mb(),
+            s.in_use as f64 / 1048576.0,
+            s.allocated as f64 / 1048576.0
+        );
+    }
+}

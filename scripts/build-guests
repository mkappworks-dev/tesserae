#!/usr/bin/env bash
# Builds test guests to target/guests and the Terra Game to games/terra/dist/games/terra,
# beside an empty dist/mods, the layout `--mods games/terra/dist/mods` reads. Also builds the
# demo Games (meadow, ember, tidewater, lumen) into their own project folders.
#
# Cargo may use a shared target directory; metadata locates the artifact
# under either layout before the finished component is copied out.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

guests=crates/tesserae-mods/tests/guests
out="$PWD/target/guests"
mkdir -p "$out"

for dir in "$guests"/*/; do
  name=$(basename "$dir")
  # RUSTFLAGS is cleared: cargo-ci's -D warnings would fail a guest on a lint
  # of wit-bindgen's generated code.
  RUSTFLAGS= cargo build --manifest-path "$dir/Cargo.toml" \
    --target wasm32-wasip2 --release --locked
  guest_target=$(cargo metadata --manifest-path "$dir/Cargo.toml" --no-deps \
    --format-version 1 | jq -r .target_directory)
  cp "$guest_target/wasm32-wasip2/release/${name//-/_}.wasm" "$out/$name.wasm"
done

RUSTFLAGS= cargo build --manifest-path games/terra/Cargo.toml \
  --target wasm32-wasip2 --release --locked
mkdir -p games/terra/dist/games/terra games/terra/dist/mods
terra_target=$(cargo metadata --manifest-path games/terra/Cargo.toml --no-deps \
  --format-version 1 | jq -r .target_directory)
cp "$terra_target/wasm32-wasip2/release/terra.wasm" games/terra/dist/games/terra/
cp games/terra/mod.toml games/terra/dist/games/terra/

# The demo Games depend on the data Mods in mods/, so they are not installed beside Terra (a
# World with no record loads every Mod there). Each component lands in its project folder, where
# `tesserae validate games/<id> --mods mods --trust-for-run` and the tests find it.
for game in meadow; do
  RUSTFLAGS= cargo build --manifest-path "games/$game/Cargo.toml" \
    --target wasm32-wasip2 --release --locked
  game_target=$(cargo metadata --manifest-path "games/$game/Cargo.toml" --no-deps \
    --format-version 1 | jq -r .target_directory)
  cp "$game_target/wasm32-wasip2/release/$game.wasm" "games/$game/$game.wasm"
done

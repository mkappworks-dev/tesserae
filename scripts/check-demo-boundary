#!/usr/bin/env python3
"""The demo builds only against the published WIT surface (ADR-0004)."""

import pathlib
import re
import json
import subprocess

root = pathlib.Path(__file__).resolve().parent.parent
manifest = root / "games/demo/Cargo.toml"
metadata = json.loads(subprocess.check_output([
    "cargo", "metadata", "--manifest-path", str(manifest),
    "--no-deps", "--format-version", "1", "--locked",
]))
for dependency in metadata["packages"][0]["dependencies"]:
    if dependency["name"] != "wit-bindgen" or dependency["source"] is None:
        raise SystemExit(f"{manifest}: only registry wit-bindgen is allowed")
for path in [manifest, *(root / "games/demo/src").rglob("*")]:
    if path.is_dir():
        continue
    text = path.read_text().replace("../../crates/tesserae-mods/wit", "WIT_CONTRACT")
    if re.search(r"crates[/\\]|tesserae[-_]core|\.\.[/\\]|\b(?:include|include_str|include_bytes)!", text):
        raise SystemExit(f"{path}: demo must use only the WIT contract")
print("demo contract boundary is clean")

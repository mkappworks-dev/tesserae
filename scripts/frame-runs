#!/usr/bin/env bash
# Runs the `dev` capture N times and prints the median and range of each frame
# figure, so a streaming change is judged on several runs rather than one: the
# worst frame swings run to run (65-115 ms across three runs of one build).
#
#   scripts/frame-runs [N]        N defaults to 5
#
# TESSERAE_SCREENSHOT_SPEED_M_S sets the flight speed (default: the camera's own,
# 12 m/s); the other TESSERAE_SCREENSHOT_* variables pass through unchanged.
#
# Run it on `main` and on the branch with the same N and quote both. Needs a
# display; macOS Screen Recording permission is not required.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

runs="${1:-5}"
out="$(mktemp -d)"
trap 'rm -rf "$out"' EXIT

cargo build -q -p tesserae --features dev --locked

lines=()
for i in $(seq "$runs"); do
  TESSERAE_SCREENSHOT="$out/run$i.png" cargo run -q -p tesserae --features dev --locked 2>&1 |
    sed $'s/\x1b\\[[0-9;]*m//g' | grep -E ' capture(_cost)? ' | sed -E 's/.* capture(_cost)? //' | paste -sd' ' - >"$out/run$i.txt" || true
  if [ ! -s "$out/run$i.txt" ]; then
    echo "run $i: no capture line" >&2
    exit 1
  fi
  cat "$out/run$i.txt"
  lines+=("$(cat "$out/run$i.txt")")
done

printf '\n%-18s %10s %10s %10s\n' figure median min max
for key in worst_tick_ms worst_cost_fill_ms worst_cost_flight_ms mean_upload_us shown_s fill_s worst_fill_ms worst_flight_ms median_flight_ms p99_flight_ms loaded meshed relight_landed relight_stale mesh_landed mesh_stale; do
  values=$(printf '%s\n' "${lines[@]}" | tr ' ' '\n' | sed -n "s/^$key=//p" | grep -E '^[0-9.]+$' | sort -n || true)
  [ -n "$values" ] || { printf '%-18s %10s\n' "$key" "n/a"; continue; }
  n=$(wc -l <<<"$values" | tr -d ' ')
  median=$(sed -n "$(((n + 1) / 2))p" <<<"$values")
  printf '%-18s %10s %10s %10s\n' "$key" "$median" "$(head -1 <<<"$values")" "$(tail -1 <<<"$values")"
done

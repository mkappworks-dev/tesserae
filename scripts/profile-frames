#!/usr/bin/env python3
"""Sequential rendered fixtures. Builds are deliberately a separate operation."""
import argparse
import csv
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shutil
import subprocess
import time
from datetime import datetime, timezone

ROOT = Path(__file__).resolve().parents[1]
FIXTURES = ['active', 'stationary', 'flight', 'transparency',
            'sprint-flight', 'sprint-walk', 'dive', 'teleport', 'cave', 'hidden-hill', 'restart', 'revisit']
# Saved to a fresh World folder inside each run's own folder.
PERSISTENT = ['restart', 'revisit']
# Per fixture, what moves the Eye; teleport's jump is the Server's, at 22 s.
MOTION = {
    'flight': dict(TESSERAE_SCREENSHOT_SPEED_M_S='12'),
    'sprint-flight': dict(TESSERAE_SCREENSHOT_SPEED_M_S='64'),
    'sprint-walk': dict(TESSERAE_FIXTURE_MOVEMENT='physics', TESSERAE_SCREENSHOT_SPRINT='1',
                        TESSERAE_SCREENSHOT_SPEED_M_S='8'),
    # Up 320 m over 22-27 s and back down over 27-32 s, both at 64 m/s.
    'dive': dict(TESSERAE_SCREENSHOT_DIVE_M='320', TESSERAE_SCREENSHOT_FLY_AFTER_S='22',
                 TESSERAE_SCREENSHOT_FLY_S='10'),
    # The Server puts the Eye in a cave; it turns through 360 degrees over 22-32 s.
    # Looks under a ridge at floor shadowed by a hill the sight walk does not enter.
    'hidden-hill': dict(TESSERAE_SCREENSHOT_YAW_DEG='-81.1', TESSERAE_SCREENSHOT_PITCH_DEG='-13.1'),
    'cave': dict(TESSERAE_SCREENSHOT_TURN_DEG='360', TESSERAE_SCREENSHOT_PITCH_DEG='0',
                 TESSERAE_SCREENSHOT_FLY_AFTER_S='22', TESSERAE_SCREENSHOT_FLY_S='10'),
}


def digest(path):
    value = hashlib.sha256()
    with path.open('rb') as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b''):
            value.update(chunk)
    return value.hexdigest()


def distribution(values):
    values = sorted(values)
    return dict(n=len(values), **{
        key: values[max(0, math.ceil(len(values) * p) - 1)] if values else None
        for key, p in [('p50', .5), ('p95', .95), ('p99', .99), ('max', 1)]
    })


STAGES = ['generate', 'relight', 'mesh']


def work(flow, start, end):
    """Worker CPU per level and stage from `start` to the last flow tick at or
    before `end`, and coarse generation's share of it."""
    def last(level, t):
        picked = [r for r in flow if int(r['level']) == level and float(r['t_s']) <= t]
        return picked[-1] if picked else None
    def counters(r):
        return {k: float(r[f'{k}_cpu_ms']) for k in STAGES + ['fluid']} if r else None
    levels, fluid = {}, 0.0
    for level in sorted({int(r['level']) for r in flow}):
        before, after = counters(last(level, start - 1e-9)), counters(last(level, end))
        if not after:
            continue
        # Counters run since the World opened, so a reopened World starts them at zero.
        if not before or any(after[k] < before[k] for k in after):
            before = dict.fromkeys(after, 0.0)
        levels[str(level)] = {k: after[k] - before[k] for k in STAGES}
        if level == 0:
            fluid = after['fluid'] - before['fluid']
    total = sum(sum(w.values()) for w in levels.values()) + fluid
    coarse = sum(w['generate'] for level, w in levels.items() if level != '0')
    return dict(worker_cpu_ms=levels, fluid_cpu_ms=fluid,
                coarse_generate_share=coarse / total if total else None)


def coarse_generated(flow, start, end):
    """First flow tick in [start, end] at which every coarse level's load extent
    is held or in flight, after one at which some of it was not."""
    ticks = {}
    for r in flow:
        if int(r['level']) > 0 and start <= float(r['t_s']) <= end:
            ticks.setdefault(float(r['t_s']), []).append(int(r['generate_waiting']))
    waited = False
    for t, waiting in sorted(ticks.items()):
        waited |= any(waiting)
        if waited and not any(waiting):
            return t
    return None


def moves(rows, flow):
    """Per fixture move (a jump, or the restart's reopen): how long after its
    first frame streaming settled, the frameless gap before that frame, and
    worker CPU per level and stage from the move until settled; then the same
    until coarse generation caught up, which `streaming_settled` does not wait
    for."""
    out = []
    for move in sorted({int(r['fixture_moves']) for r in rows} - {0}):
        first = next(i for i, r in enumerate(rows) if int(r['fixture_moves']) == move)
        leg = [r for r in rows[first:] if int(r['fixture_moves']) == move]
        start, end = float(leg[0]['start_s']), float(leg[-1]['end_s'])
        # Stats published before a jump still read settled.
        unsettled = next((i for i, r in enumerate(leg) if r['streaming_settled'] != 'true'), None)
        settled = None if unsettled is None else next(
            (r for r in leg[unsettled:] if r['streaming_settled'] == 'true'), None)
        entry = dict(move=move, settle_s=float(settled['start_s']) - start if settled else None,
                     blank_s=start - float(rows[first - 1]['end_s']) if first else 0.0)
        if settled and flow:
            entry.update(work(flow, start, float(settled['end_s'])))
        if flow:
            t = coarse_generated(flow, start, end)
            entry['coarse_generated'] = t and dict(s=t - start, **work(flow, start, t))
        out.append(entry)
    return out


def streaming(path, rows):
    """Holes, GPU spans and worker time in the fixture phase, where recorded."""
    fixture = [r for r in rows if r['phase'] == 'fixture']
    if not fixture or 'rule_holes' not in fixture[0]:
        return None
    ids = {r['frame_id'] for r in fixture}
    out = {
        'chunk_entities': distribution([float(r['chunk_entities']) for r in fixture]),
        'visible_meshes': {
            key[len('visible_meshes_'):]: distribution([float(r[key]) for r in fixture])
            for key in fixture[0] if key.startswith('visible_meshes_')},
    }
    # Counted only under --instruments holes.
    if fixture[0]['rule_holes']:
        out.update(
            rule_hole_frames=sum(int(r['rule_holes']) > 0 for r in fixture),
            fill_hole_frames=sum(int(r['fill_holes']) > 0 for r in fixture),
            rule_holes_max=max(int(r['rule_holes']) for r in fixture),
            fill_holes_max=max(int(r['fill_holes']) for r in fixture))
    gpu_path = path.with_suffix('.gpu.csv')
    if gpu_path.exists():
        marks = {}
        for r in csv.DictReader(gpu_path.read_text().splitlines()):
            if r['frame_id'] in ids and r['since_frame_start_ms']:
                marks.setdefault(r['frame_id'], {})[r['marker']] = float(r['since_frame_start_ms'])
        def span(a, b):
            return distribution([m[b] - m[a] for m in marks.values() if a in m and b in m])
        cameras = sorted({k.split(':')[0] for m in marks.values() for k in m if ':' in k})
        out['gpu'] = {
            'frames_with_end': len([m for m in marks.values() if 'frame_end' in m]),
            'frames': len(ids), 'frame_ms': span('frame_start', 'frame_end'),
            'views': {c: {
                'view_ms': span(f'{c}:view_start', f'{c}:view_end'),
                'prepass_ms': span(f'{c}:view_start', f'{c}:prepass_end'),
                'shadow_and_setup_ms': span(f'{c}:prepass_end', f'{c}:main_start'),
                'opaque_ms': span(f'{c}:main_start', f'{c}:opaque_end'),
                'transparent_ms': span(f'{c}:opaque_end', f'{c}:main_end'),
                'post_ms': span(f'{c}:main_end', f'{c}:view_end'),
            } for c in cameras},
        }
    flow_path = path.with_suffix('.flow.csv')
    if flow_path.exists():
        flow = list(csv.DictReader(flow_path.read_text().splitlines()))
        start, end = float(fixture[0]['start_s']), float(fixture[-1]['end_s'])
        def at(t, level):
            picked = [r for r in flow if int(r['level']) == level and float(r['t_s']) <= t]
            return picked[-1] if picked else None
        seconds = end - start
        work = {}
        for level in sorted({int(r['level']) for r in flow}):
            a, b = at(start, level), at(end, level)
            if not a or not b:
                continue
            work[level] = {
                f'{stage}_worker_ms_per_s': (float(b[f'{stage}_cpu_ms']) - float(a[f'{stage}_cpu_ms'])) / seconds
                for stage in ['generate', 'relight', 'mesh']}
            for stage in ['generate', 'relight', 'mesh']:
                work[level][f'{stage}_run'] = int(b[f'{stage}_run']) - int(a[f'{stage}_run'])
                work[level][f'{stage}_waiting_max'] = max(
                    int(r[f'{stage}_waiting']) for r in flow
                    if int(r['level']) == level and start <= float(r['t_s']) <= end)
            if level == 0:
                work[level]['fluid_worker_ms_per_s'] = (
                    float(b['fluid_cpu_ms']) - float(a['fluid_cpu_ms'])) / seconds
        out['workers'] = work
    if 'fixture_moves' in rows[0]:
        out['moves'] = moves(rows, flow if flow_path.exists() else [])
    return out


def analyze(folder):
    result = {}
    audit = {}
    streaming_summary = {}
    for path in sorted(folder.glob('*/frames.csv')):
        rows = list(csv.DictReader(path.read_text().splitlines()))
        assert [int(r['frame_id']) for r in rows] == list(range(len(rows)))
        summary = streaming(path, rows)
        if summary:
            streaming_summary[path.parent.name] = summary
        result[path.parent.name] = {}
        for phase in ['startup', 'stationary', 'transition', 'fixture', 'settle']:
            selected = [r for r in rows if r['phase'] == phase]
            result[path.parent.name][phase] = {
                key: distribution([float(r[key]) for r in selected if r[key]])
                for key in rows[0] if key.endswith('_ms')
            }
        render_reader = csv.DictReader(path.with_suffix('.render.csv').read_text().splitlines())
        render = list(render_reader)
        render_metrics = [key for key in render_reader.fieldnames or [] if key.endswith('_ms')]
        assert len({r['frame_id'] for r in render}) == len(render)
        by_id = {r['frame_id']: r['phase'] for r in rows}
        if 'start_s' in rows[0]:
            fixture = [r for r in rows if r['phase'] == 'fixture']
            audit[path.parent.name] = {
                'complete_fixture_window': bool(fixture) and float(fixture[-1]['end_s']) >= 31.9,
                'streaming_ready_before_flight': any(
                    r['streaming_settled'] == 'true' and float(r['start_s']) < 20
                    for r in rows),
                'simulation_step_advance': int(fixture[-1]['simulation_step']) - int(fixture[0]['simulation_step']) if fixture else 0,
                'simulation_landed_delta': int(fixture[-1]['landed']) - int(fixture[0]['landed']) if fixture else 0,
                'fixture_ready_all': all(r.get('fixture_ready') == 'true' for r in fixture),
                'fire_burning_frames': sum(r.get('fixture_fire_burning') == 'true' for r in fixture),
                'fixture_frames': len(fixture),
                'focused_fixture_frames': sum(r.get('focused') == 'true' for r in fixture),
                'no_ground': 'no ground' in (path.parent / 'native.log').read_text().lower()
                    if (path.parent / 'native.log').exists() else None,
                'fixture_ignitions': max((int(r.get('fixture_ignitions', 0)) for r in fixture), default=0),
                'render_rows': len(render), 'frame_rows': len(rows),
            }
        for phase in result[path.parent.name]:
            for key in render_metrics:
                result[path.parent.name][phase][key] = distribution([
                    float(r[key]) for r in render
                    if by_id.get(r['frame_id']) == phase and r[key]
                ])
    (folder / 'audit.json').write_text(json.dumps(audit, indent=2) + '\n')
    (folder / 'streaming.json').write_text(json.dumps(streaming_summary, indent=2) + '\n')
    overhead = {}
    for path in sorted(folder.glob('*-on/native.log')):
        off = path.parent.with_name(path.parent.name[:-3] + '-off') / 'native.log'
        if not off.exists():
            continue
        def legacy(log):
            return {key: float(value) for key, value in re.findall(
                r'(median_flight_ms|p99_flight_ms)=([0-9.]+)', log.read_text())}
        on_values, off_values = legacy(path), legacy(off)
        overhead[path.parent.name] = {
            key: {'on_ms': value, 'off_ms': off_values[key],
                  'ratio': value / off_values[key] if off_values[key] else None,
                  'rounding_ms': 0.1}
            for key, value in on_values.items() if key in off_values
        }
    (folder / 'overhead.json').write_text(json.dumps(overhead, indent=2) + '\n')
    (folder / 'summary.json').write_text(json.dumps(result, indent=2) + '\n')


def competitors():
    ps = subprocess.check_output(['ps', '-axo', 'pid=,comm='], text=True)
    return [line for line in ps.splitlines() if re.search(
        r'/(cargo|rustc|tesserae[^/ ]*|meshing-[^/ ]+|fluids-[^/ ]+)$', line)]


SWITCHES = ['no-coverage-discard', 'level0-only', 'msaa-off', 'msaa-4', 'msaa-2', 'fxaa', 'smaa', 'no-shadows']


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--binary', type=Path)
    parser.add_argument('--profile', choices=['dev', 'release'])
    parser.add_argument('--features', help='exact Cargo features used for this executable')
    parser.add_argument('--game', type=Path, default=ROOT / 'games/demo/dist/mods')
    parser.add_argument('--presented', action='store_true')
    parser.add_argument('--monitor-hz', type=int, help='select the unique monitor reporting this refresh rate (within 1 Hz)')
    # An engine without views ignores it, so one runner serves an A/B against main.
    parser.add_argument('--view', choices=['first', 'third'], default='first')
    parser.add_argument('--repeats', type=int, default=3)
    parser.add_argument('--fixtures', nargs='+', choices=FIXTURES,
                        default=['active', 'stationary', 'flight', 'transparency'])
    # Each costs more than the overhead bound, so a timing series leaves them off.
    parser.add_argument('--instruments', nargs='+', choices=['gpu', 'holes', 'visibility', 'waits'], default=[])
    parser.add_argument('--size', default='1920x1080', metavar='WxH',
                        help='physical target size offscreen, or with --presented --monitor-hz')
    # Each changes one cost and the image; a `profiling` build only, never a timing baseline.
    parser.add_argument('--switches', nargs='+', default=[], choices=SWITCHES)
    # Overrides the render scale setting; each run records the scale the engine used.
    parser.add_argument('--render-scale', type=int, choices=[100, 85, 75, 67])
    parser.add_argument('--sharpen', choices=['on', 'off'])
    parser.add_argument('--analyze-only', action='store_true')
    parser.add_argument('output', type=Path)
    args = parser.parse_args()
    width, height = (int(v) for v in args.size.split('x'))
    if args.analyze_only:
        analyze(args.output)
        return
    if args.monitor_hz is not None and (not args.presented or args.monitor_hz <= 0):
        parser.error('--monitor-hz requires --presented and a positive integer')
    if not args.binary or not args.profile or not args.features:
        parser.error('--binary, --profile and --features are required')
    if args.repeats < 3:
        parser.error('comparisons require at least three interleaved rounds')
    if not args.game.is_dir():
        parser.error('Game distribution is missing; use the existing built distribution')
    if competitors():
        raise SystemExit('Competing build/benchmark process: ' + str(competitors()))
    # mkdir is exclusive; a host-wide lock prevents this runner competing with itself.
    lock = Path('/tmp/tesserae-frame-profile.lock')
    lock.mkdir()
    try:
        args.output.mkdir(parents=True, exist_ok=False)
        binary = args.output.resolve() / 'tesserae-profile'
        shutil.copy2(args.binary, binary)
        shutil.copy2(__file__, args.output / 'profile-frames.py')
        metadata = {
            'executable_sha256': digest(binary), 'build_profile': args.profile,
            'driver_sha256': digest(Path(__file__)),
            'manifests': {str(p.relative_to(ROOT)): digest(p) for p in [
                ROOT / 'Cargo.toml', ROOT / 'Cargo.lock',
                ROOT / 'crates/tesserae/Cargo.toml']},
            'features': args.features, 'engine_head': subprocess.check_output(
                ['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
            'engine_diff_sha256': hashlib.sha256(subprocess.check_output(
                ['git', 'diff', 'HEAD'], cwd=ROOT)).hexdigest(),
            'engine_sources': {str(p.relative_to(ROOT)): digest(p)
                               for p in (ROOT / 'crates').rglob('*.rs')},
            'game': {str(p.relative_to(args.game.parent)): digest(p)
                     for p in sorted(args.game.parent.rglob('*')) if p.is_file()},
            'host': subprocess.check_output(['uname', '-a'], text=True).strip(),
            'kind': 'rendered-presented' if args.presented else 'rendered-offscreen',
            'seed': '0x7e55e2ae00000001', 'quality': 'unchanged', 'view': args.view,
            'phase_boundaries_s': [0, 16, 20, 22, 32], 'instruments': args.instruments,
            'physical_target': 'window (see runtime metadata)' if args.presented else [width, height],
            'switches': args.switches,
            'requested_monitor_hz': args.monitor_hz,
            'requested_render_scale': args.render_scale, 'requested_sharpen': args.sharpen,
        }
        (args.output / 'provenance.json').write_text(json.dumps(metadata, indent=2) + '\n')
        for repeat in range(args.repeats):
            cases = list(args.fixtures)
            if repeat % 2:
                cases.reverse()
            for case in cases:
                for enabled in ([True, False] if repeat % 2 == 0 else [False, True]):
                    if competitors():
                        raise SystemExit('Contended run refused: ' + str(competitors()))
                    run = args.output / f'{case}-{repeat + 1}-{"on" if enabled else "off"}'
                    run.mkdir()
                    env = {k: v for k, v in os.environ.items()
                           if not k.startswith('TESSERAE_')}
                    env.update(RUST_LOG='info,wgpu_core::device::resource=debug', BEVY_ASSET_ROOT=str(ROOT), TESSERAE_MODS_DIR=str(args.game.resolve()),
                               TESSERAE_TRUST_MODS='1', TESSERAE_PROFILE_FIXTURE=case,
                               TESSERAE_SCREENSHOT=str(run.resolve() / 'capture.png'),
                               TESSERAE_SCREENSHOT_WIDTH=str(width), TESSERAE_SCREENSHOT_HEIGHT=str(height),
                               TESSERAE_SCREENSHOT_FLY_AFTER_S='20', TESSERAE_SCREENSHOT_FLY_S='12',
                               TESSERAE_SCREENSHOT_SETTLE_S='1', TESSERAE_SCREENSHOT_VIEW=args.view,
                               TESSERAE_SCREENSHOT_SPEED_M_S='0')
                    env.update(MOTION.get(case, {}))
                    for name in args.switches:
                        env['TESSERAE_DIAG_' + name.upper().replace('-', '_')] = '1'
                    if args.monitor_hz is not None:
                        env['TESSERAE_PROFILE_MONITOR_HZ'] = str(args.monitor_hz)
                    if args.render_scale:
                        env['TESSERAE_SCREENSHOT_RENDER_SCALE'] = str(args.render_scale)
                    if args.sharpen:
                        env['TESSERAE_SCREENSHOT_SHARPEN'] = '1' if args.sharpen == 'on' else '0'
                    if case in PERSISTENT:
                        env['TESSERAE_WORLD_DIR'] = str(run.resolve() / 'world')
                    if not args.presented:
                        env['TESSERAE_SCREENSHOT_OFFSCREEN'] = '1'
                    if enabled:
                        env['TESSERAE_PROFILE_CSV'] = str(run.resolve() / 'frames.csv')
                        for name in args.instruments:
                            env[f'TESSERAE_PROFILE_{name.upper()}'] = '1'
                    # Continuous updates must match with logging on and off.
                    env['TESSERAE_PROFILE_CONTINUOUS'] = '1'
                    print('Running', run.name, flush=True)
                    record = dict(
                        host_before=host_observation(),
                        env={k: v for k, v in env.items() if k.startswith('TESSERAE_')},
                        executable_sha256=digest(binary))
                    (run / 'run.json').write_text(json.dumps(record, indent=2) + '\n')
                    start = time.monotonic()
                    try:
                        with (run / 'native.log').open('w') as log:
                            process = subprocess.run(
                                ['/usr/bin/caffeinate', '-i', str(binary)], cwd=ROOT,
                                env=env, stdout=log, stderr=subprocess.STDOUT,
                                check=True, timeout=120)
                            record['returncode'] = process.returncode
                    except subprocess.CalledProcessError as error:
                        record['returncode'] = error.returncode
                        raise
                    except subprocess.TimeoutExpired:
                        record['timed_out'] = True
                        raise
                    finally:
                        record.update(elapsed_s=time.monotonic() - start,
                                      host_after=host_observation(),
                                      engine_presentation=engine_presentation(run))
                        (run / 'run.json').write_text(json.dumps(record, indent=2) + '\n')
                    if args.monitor_hz is not None:
                        assert monitor_selected(run, args.monitor_hz, (width, height)), 'Requested monitor selection was not confirmed'
                    if enabled:
                        measured = list(csv.DictReader((run / 'frames.csv').read_text().splitlines()))
                        fixture_rows = [r for r in measured if r['phase'] == 'fixture']
                        assert fixture_rows and float(fixture_rows[-1]['end_s']) >= 31.9, 'Incomplete fixture window'
                        assert all(r['fixture_ready'] == 'true' for r in fixture_rows), 'Fixture not ready'
                        if case == 'active':
                            assert all(r['fixture_fire_burning'] == 'true' for r in fixture_rows), 'Fire was inactive in the measurement window'
        analyze(args.output)
    finally:
        lock.rmdir()


def monitor_selected(run, hz, size=None):
    rates = re.findall(r'profile_monitor_selected refresh_millihertz=(\d+)',
                       (run / 'native.log').read_text())
    meta = run / 'frames.metadata.txt'
    if meta.exists():
        reported = re.findall(r'reported_refresh_millihertz=Some\((\d+)\)', meta.read_text())
        if not reported:
            return False
        if size is not None:
            sizes = re.findall(r'^window=(\d+)x(\d+)', meta.read_text(), re.MULTILINE)
            if not sizes or any(tuple(map(int, value)) != size for value in sizes):
                return False
        rates.extend(reported)
    return bool(rates) and all(abs(int(rate) - hz * 1000) <= 1000 for rate in rates)


def host_observation():
    """Outside the measured process; retain failures rather than guessing state."""
    result = dict(utc=datetime.now(timezone.utc).isoformat(), load_average=list(os.getloadavg()))
    for key, command in [('power', ['pmset', '-g', 'batt']),
                         ('thermal', ['pmset', '-g', 'therm'])]:
        try:
            observation = subprocess.run(command, capture_output=True, text=True, timeout=5)
            result[key] = dict(returncode=observation.returncode,
                               stdout=observation.stdout, stderr=observation.stderr)
        except (OSError, subprocess.TimeoutExpired) as error:
            result[key] = dict(error=str(error))
    return result


def engine_presentation(run):
    """The anti-aliasing, render scale and sharpening the engine reports, or None without logging."""
    meta = run / 'frames.metadata.txt'
    if not meta.exists():
        return None
    for line in meta.read_text().splitlines():
        if line.startswith('selected_display_sync='):
            fields = dict(f.split('=', 1) for f in line.split())
            return {k: fields.get(k) for k in ('anti_aliasing', 'render_scale', 'sharpen')}
    return None


if __name__ == '__main__':
    main()

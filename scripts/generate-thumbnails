#!/usr/bin/env python3
"""Writes the 512 by 288 menu thumbnails of the demo Games and of the Mods listed in MODS and
CHARACTERS, each as thumbnail.png beside its mod.toml.

A Mod's thumbnail draws its own Materials as Voxels, textured from the art that
scripts/generate-mod-art wrote, so run that first; a Character Mod's draws its figure from its
skin.png. A Game's thumbnail is a small seeded island
drawn in the Game's colours. The images are original and generated here, so they are CC0 and their
source is this file. Output is deterministic, so a re-run changes no file.
"""

import math
import pathlib
import struct
import zlib

WIDTH, HEIGHT = 512, 288
repo = pathlib.Path(__file__).resolve().parent.parent

# Mod id -> what stands in its row, left to right: a texture name is a Voxel of that texture, an
# RGBA colour a plain Voxel (for a Material with no texture, as its appearance row gives it),
# ("noise", RGBA, seed) a Voxel textured with noise in that colour, and ("plant", texture, ground)
# the plant's sprite standing on a Voxel of `ground`, a "mod/texture" path.
MODS = {
    "timber": ["planks", "thatch"],
    "crystals": ["amethyst", "citrine", "aquamarine"],
    "hearth": ["ash", "lava"],
    "frost": ["snow", "ice", "packed_ice"],
    "strata": ["turf", "soil", "sand", "stone"],
    "waters": [(26, 82, 158, 166), "obsidian"],
    "bog": ["peat", ("noise", (92, 70, 44, 224), 61), ("noise", (24, 22, 28, 255), 67)],
    "brickwork": ["brick", "cobble", "tile"],
    "glassworks": ["glass", "frosted_glass", "lantern"],
    "lamps": ["glowstone", "amberlight", "moonlight"],
    "wool": ["wool_red", "wool_yellow", "wool_green", "wool_blue"],
    "flora": ["wood", "leaves", ("plant", "poppy", "strata/turf"), ("plant", "fern", "strata/turf")],
    "crops": [
        ("plant", "wheat_ripe", "strata/soil"),
        ("plant", "carrot_ripe", "strata/soil"),
        ("plant", "berry_ripe", "strata/turf"),
    ],
    "aquatic": [
        ("plant", "kelp", "strata/sand"),
        ("plant", "seagrass", "strata/sand"),
        ("plant", "red_weed", "strata/sand"),
    ],
}

# Character Mods, drawn as their figure from their own skin.png.
CHARACTERS = ["sprite", "wanderer", "golem"]
BACKDROP = ((54, 56, 60), (30, 31, 34))

# Game id -> sky (top, bottom), water, shore, ground bands from low to high, side soil and rock,
# sea level (0..1), and what stands on the ground.
GAMES = {
    "terra": dict(

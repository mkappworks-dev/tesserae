def hash01(seed, x, y):
    h = (seed ^ (x * 374_761_393) ^ (y * 668_265_263)) & 0xFFFFFFFF
    h = ((h ^ (h >> 13)) * 1_274_126_177) & 0xFFFFFFFF
    return ((h ^ (h >> 16)) & 0xFFFFFFFF) / 0xFFFFFFFF


def noise(seed, x, y):
    x0, y0 = int(x // 1), int(y // 1)
    fx, fy = x - x0, y - y0
    sx, sy = fx * fx * (3 - 2 * fx), fy * fy * (3 - 2 * fy)
    a, b = hash01(seed, x0, y0), hash01(seed, x0 + 1, y0)
    c, d = hash01(seed, x0, y0 + 1), hash01(seed, x0 + 1, y0 + 1)
    return a + (b - a) * sx + (c - a) * sy + (a - b - c + d) * sx * sy


def fbm(seed, x, y):
    total, amp, norm = 0.0, 0.5, 0.0
    for octave in range(4):
        total += amp * noise(seed + octave * 101, x, y)
        norm += amp
        x, y, amp = x * 2, y * 2, amp / 2
    return total / norm


def shade(colour, factor, jitter=0):
    return tuple(max(0, min(255, int(c * factor) + jitter)) for c in colour)


class Canvas:
    def __init__(self, top, bottom):
        self.px = bytearray()
        for y in range(HEIGHT):
            t = y / (HEIGHT - 1)
            row = bytes(int(a + (b - a) * t) for a, b in zip(top, bottom))
            self.px += row * WIDTH

    def put(self, x, y, colour):
        if colour is not None and 0 <= x < WIDTH and 0 <= y < HEIGHT:
            at = (y * WIDTH + x) * 3
            self.px[at : at + 3] = bytes(colour)

    def ellipse(self, cx, cy, rx, ry, darken):
        for y in range(int(cy - ry), int(cy + ry) + 1):
            for x in range(int(cx - rx), int(cx + rx) + 1):
                d = ((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2
                if d <= 1 and 0 <= x < WIDTH and 0 <= y < HEIGHT:
                    at = (y * WIDTH + x) * 3
                    k = 1 - darken * (1 - d)
                    self.px[at : at + 3] = bytes(int(c * k) for c in self.px[at : at + 3])

    def parallelogram(self, origin, u, v, paint):
        """Fills origin + s*u + t*v for s, t in [0, 1), colouring each pixel paint(s, t)."""
        ox, oy = origin
        corners = [(ox, oy), (ox + u[0], oy + u[1]), (ox + v[0], oy + v[1])]
        corners.append((ox + u[0] + v[0], oy + u[1] + v[1]))
        det = u[0] * v[1] - u[1] * v[0]
        x0, x1 = int(min(c[0] for c in corners)), int(max(c[0] for c in corners)) + 1
        y0, y1 = int(min(c[1] for c in corners)), int(max(c[1] for c in corners)) + 1
        for y in range(max(0, y0), min(HEIGHT, y1)):
            for x in range(max(0, x0), min(WIDTH, x1)):
                dx, dy = x + 0.5 - ox, y + 0.5 - oy
                s = (dx * v[1] - dy * v[0]) / det
                t = (u[0] * dy - u[1] * dx) / det
                if 0 <= s < 1 and 0 <= t < 1:
                    self.at = (x, y)
                    self.put(x, y, paint(s, t))

    def under(self):
        """The pixel parallelogram() is painting, before it is painted."""
        x, y = self.at
        at = (y * WIDTH + x) * 3
        return tuple(self.px[at : at + 3])

    def box(self, top, a, h, paint_top, paint_left, paint_right):
        """An isometric box whose top face's back corner is `top`; half-width a, height h."""
        x, y = top
        b = a / 2
        self.parallelogram((x, y), (a, b), (-a, b), paint_top)
        self.parallelogram((x - a, y + b), (a, b), (0, h), paint_left)
        self.parallelogram((x, y + 2 * b), (a, -b), (0, h), paint_right)

    def png(self):
        rows = b"".join(
            b"\x00" + bytes(self.px[y * WIDTH * 3 : (y + 1) * WIDTH * 3]) for y in range(HEIGHT)
        )

        def chunk(kind, data):
            body = kind + data
            return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body))

        header = struct.pack(">IIBBBBB", WIDTH, HEIGHT, 8, 2, 0, 0, 0)
        return (
            b"\x89PNG\r\n\x1a\n"
            + chunk(b"IHDR", header)
            + chunk(b"IDAT", zlib.compress(rows, 9))
            + chunk(b"IEND", b"")
        )


def read_png(path):
    """Rows of RGBA pixels of an unfiltered 8-bit RGBA PNG, as scripts/generate-mod-art writes."""
    data = path.read_bytes()
    assert data[:8] == b"\x89PNG\r\n\x1a\n", path
    at, idat = 8, b""
    while at < len(data):
        length, kind = struct.unpack(">I4s", data[at : at + 8])
        body = data[at + 8 : at + 8 + length]
        if kind == b"IHDR":
            width, height, depth, colour, _, _, interlace = struct.unpack(">IIBBBBB", body)
            assert (depth, colour, interlace) == (8, 6, 0), f"{path}: not 8-bit RGBA"
        elif kind == b"IDAT":
            idat += body
        at += 12 + length
    raw = zlib.decompress(idat)
    stride = width * 4 + 1
    pixels = []
    for y in range(height):
        row = raw[y * stride : (y + 1) * stride]
        assert row[0] == 0, f"{path}: a filtered row; generate-mod-art writes none"
        pixels.append([tuple(row[1 + x * 4 : 5 + x * 4]) for x in range(width)])
    return pixels


def read_texture(path):
    """The three 16 by 16 faces (top, side, bottom) of a texture scripts/generate-mod-art wrote."""
    pixels = read_png(path)
    edge = len(pixels)
    return [[r[f * edge : (f + 1) * edge] for r in pixels] for f in range(3)]


def textured(face, light, canvas=None):
    """Paints a face; a see-through pixel is blended over the canvas when one is given (glass),
    and is otherwise a dark cut-out hole."""
    edge = len(face)

    def paint(s, t):
        r, g, b, a = face[min(edge - 1, int(t * edge))][min(edge - 1, int(s * edge))]
        if canvas is not None and a < 255:
            k = a / 255
            under = canvas.under()
            r, g, b = (int(c * k + u * (1 - k)) for c, u in zip((r, g, b), under))
        elif a < 128:
            r, g, b = (r // 3, g // 3, b // 3)
        return shade((r, g, b), light)

    return paint


def plain(rgba, light, canvas):
    """A colour with a little grain, blended over the canvas by its alpha."""
    *colour, a = rgba

    def paint(s, t):
        grain = int(hash01(5, int(s * 16), int(t * 16)) * 12) - 6
        k = a / 255
        mixed = (int(c * k + u * (1 - k)) for c, u in zip(colour, canvas.under()))
        return shade(tuple(mixed), light, grain)

    return paint


def noisy(rgba, seed):
    """Three 16 by 16 faces of fbm noise around a colour, so a Material with no texture of its own
    reads as textured beside those that have one."""
    *colour, a = rgba
    # Dark colours scale to near-black, so the noise is added as an offset, not a factor.
    spread = max(36, max(colour) // 2)

    def face(offset):
        rows = []
        for y in range(16):
            row = []
            for x in range(16):
                n = fbm(seed + offset, x * 0.3, y * 0.3) - 0.5
                speck = 0.6 if hash01(seed + offset, x, y) > 0.93 else 0
                lift = int((n * 1.6 + speck) * spread)
                row.append((*shade(colour, 1.0, lift), a))
            rows.append(row)
        return rows

    return [face(0), face(1000), face(2000)]


def texture(mod, name):
    if "/" in name:
        mod, name = name.split("/")
    return read_texture(repo / "mods" / mod / "art" / f"{name}.png")


def sprite(canvas, face, left, top, size):
    """A plant's side face, upright and facing the viewer; its clear pixels are left out."""
    edge = len(face)
    for y in range(int(top), int(top + size)):
        for x in range(int(left), int(left + size)):
            fx = int((x - left) / size * edge)
            fy = int((y - top) / size * edge)
            r, g, b, a = face[min(edge - 1, fy)][min(edge - 1, fx)]
            if a >= 128:
                canvas.put(x, y, (r, g, b))


def mod_thumbnail(mod, items):
    canvas = Canvas(*BACKDROP)
    gap = 30
    a = min(70 if len(items) < 3 else 60, (WIDTH - 40 - (len(items) - 1) * gap) / (2 * len(items)))
    span = len(items) * 2 * a + (len(items) - 1) * gap
    left = (WIDTH - span) / 2
    plants = any(isinstance(item, tuple) and item[0] == "plant" for item in items)
    for i, item in enumerate(items):
        cx = left + a + i * (2 * a + gap)
        # Middle Voxels sit a little higher, so a row reads as a group, not a shelf.
        lift = 10 if 0 < i < len(items) - 1 else 0
        # A row with plants sits lower, so the sprites above it stay in the frame.
        cy = (HEIGHT - 2 * a) / 2 - lift + (a * 0.45 if plants else 0)
        canvas.ellipse(cx, cy + 1.5 * a + lift + 6, a * 1.2, a * 0.58, 0.5)
        plant = None
        if isinstance(item, tuple) and item[0] == "plant":
            _, plant, item = item
        if isinstance(item, tuple) and item[0] == "noise":
            top, side, _ = noisy(*item[1:])
            faces = [textured(top, 1.0, canvas), textured(side, 0.82, canvas), textured(side, 0.64, canvas)]
        elif isinstance(item, tuple):
            faces = [plain(item, k, canvas) for k in (1.0, 0.82, 0.64)]
        else:
            top, side, _ = texture(mod, item)
            glass = any(p[3] < 255 for row in top for p in row) and min(
                p[3] for row in top for p in row
            ) > 0
            under = canvas if glass else None
            faces = [textured(top, 1.0, under), textured(side, 0.82, under), textured(side, 0.64, under)]
        canvas.box((cx, cy), a, a, *faces)
        if plant:
            _, side, _ = texture(mod, plant)
            size = 1.5 * a
            sprite(canvas, side, cx - size / 2, cy + a / 2 - size + a * 0.1, size)
    return canvas.png()


def rotate_x(p, pivot, angle):
    y, z = p[1] - pivot[1], p[2] - pivot[2]
    c, s = math.cos(angle), math.sin(angle)
    return (p[0], pivot[1] + y * c - z * s, pivot[2] + y * s + z * c)


def character_thumbnail(mod):
    """The Mod's six-bone figure in a mid-stride three-quarter view, each face textured from its
    skin with the same box layout as the Client's avatar (client/avatar.rs, cube_mesh)."""
    skin = read_png(repo / "mods" / mod / "skin.png")
    canvas = Canvas(*BACKDROP)
    # (skin uv, origin, size, pivot, swing forward in radians), as every Character Mod declares.
    bones = [
        ((16, 16), (-4, 12, -2), (8, 12, 4), (0, 12, 0), 0.0),
        ((0, 0), (-4, 24, -4), (8, 8, 8), (0, 24, 0), 0.0),
        ((40, 16), (4, 12, -2), (4, 12, 4), (6, 22, 0), 0.45),
        ((32, 48), (-8, 12, -2), (4, 12, 4), (-6, 22, 0), -0.45),
        ((0, 16), (0, 0, -2), (4, 12, 4), (2, 12, 0), -0.4),
        ((16, 48), (-4, 0, -2), (4, 12, 4), (-2, 12, 0), 0.4),
    ]
    yaw, pitch, scale = math.radians(-32), math.radians(14), 7.4
    cy_, sy_ = math.cos(yaw), math.sin(yaw)
    cp, sp = math.cos(pitch), math.sin(pitch)

    def view(p):
        x, y, z = p
        x, z = x * cy_ + z * sy_, -x * sy_ + z * cy_
        # The viewer faces +Z, so the figure's own right (+X) lands on screen left.
        depth = -y * sp + z * cp
        up = y * cp + z * sp
        return (WIDTH / 2 - x * scale, HEIGHT - 26 - (up - (-2 * sp)) * scale, depth)

    light = (-0.45, 0.75, -0.5)
    norm = math.sqrt(sum(c * c for c in light))
    light = tuple(c / norm for c in light)
    zbuf = [math.inf] * (WIDTH * HEIGHT)
    canvas.ellipse(WIDTH / 2, HEIGHT - 26, 62, 15, 0.55)
    for (u, v), lo, (w, h, d), pivot, swing in bones:
        x0, y0, z0 = lo
        x1, y1, z1 = x0 + w, y0 + h, z0 + d
        faces = [
            ([(x1, y1, z1), (x0, y1, z1), (x1, y1, z0)], (u + d, v, w, d), (0, 1, 0)),
            ([(x1, y1, z1), (x1, y1, z0), (x1, y0, z1)], (u, v + d, d, h), (1, 0, 0)),
            ([(x1, y1, z0), (x0, y1, z0), (x1, y0, z0)], (u + d, v + d, w, h), (0, 0, -1)),
            ([(x0, y1, z0), (x0, y1, z1), (x0, y0, z0)], (u + d + w, v + d, d, h), (-1, 0, 0)),
            ([(x0, y1, z1), (x1, y1, z1), (x0, y0, z1)], (u + 2 * d + w, v + d, w, h), (0, 0, 1)),
        ]
        for corners, (fu, fv, fw, fh), normal in faces:
            corners = [rotate_x(c, pivot, -swing) for c in corners]
            n = rotate_x(normal, (0, 0, 0), -swing)
            nx, nz = n[0] * cy_ + n[2] * sy_, -n[0] * sy_ + n[2] * cy_
            if -n[1] * sp + nz * cp >= 0:
                continue
            k = 0.5 + 0.5 * max(0.0, nx * -light[0] * -1 + n[1] * light[1] + nz * light[2])
            o, a_, b_ = (view(c) for c in corners)
            ux, uy, ud = a_[0] - o[0], a_[1] - o[1], a_[2] - o[2]
            vx, vy, vd = b_[0] - o[0], b_[1] - o[1], b_[2] - o[2]
            det = ux * vy - uy * vx
            xs = [o[0], a_[0], b_[0], a_[0] + vx]
            ys = [o[1], a_[1], b_[1], a_[1] + vy]
            for py in range(max(0, int(min(ys))), min(HEIGHT, int(max(ys)) + 1)):
                for px in range(max(0, int(min(xs))), min(WIDTH, int(max(xs)) + 1)):
                    dx, dy = px + 0.5 - o[0], py + 0.5 - o[1]
                    s = (dx * vy - dy * vx) / det
                    t = (ux * dy - uy * dx) / det
                    if not (0 <= s < 1 and 0 <= t < 1):
                        continue
                    depth = o[2] + s * ud + t * vd
                    at = py * WIDTH + px
                    if depth >= zbuf[at]:
                        continue
                    r, g, b, alpha = skin[int(fv + t * fh)][int(fu + s * fw)]
                    if alpha < 128:
                        continue
                    zbuf[at] = depth
                    canvas.put(px, py, shade((r, g, b), k))
    return canvas.png()


def game_thumbnail(game, look):
    canvas = Canvas(*look["sky"])
    n, a, step = 15, 11, 7
    seed = look["seed"]
    heights = {}
    for gy in range(n):
        for gx in range(n):
            # Edges fall away, so the island never fills its tile to the corners.
            edge = min(gx, gy, n - 1 - gx, n - 1 - gy) / (n / 2)
            e = fbm(seed, gx * 0.23, gy * 0.23)
            e = max(0.0, min(1.0, (e - 0.5) * 2.4 + 0.5)) * (0.7 + 0.3 * min(1.0, edge * 1.6))
            heights[gx, gy] = e
    sea = look["sea"]
    # The front corner's foot lands just above the bottom edge.
    base_y = HEIGHT - 16 - ((2 * n - 2) * a / 2 + a + 8 * step + 18)
    cx = WIDTH / 2
    canvas.ellipse(cx, base_y + n * a + 8 * step, n * a * 1.1, n * a * 0.36, 0.25)
    for depth in range(2 * n - 1):
        for gx in range(n):
            gy = depth - gx
            if not 0 <= gy < n:
                continue
            e = heights[gx, gy]
            level = 1 + int(e * 8)
            sea_level = 1 + int(sea * 8)
            wet = level <= sea_level
            if wet:
                top = look["water"]
            elif level == sea_level + 1:
                top = look["shore"]
            else:
                bands = look["bands"]
                top = bands[min(len(bands) - 1, int((e - sea) / max(0.01, 1 - sea) * len(bands)))]
            column = max(level, sea_level)
            x = cx + (gx - gy) * a
            y = base_y + (gx + gy) * a / 2 - column * step + 8 * step
            jitter = int(hash01(seed, gx, gy) * 10) - 5

            def side(light, surface=top, wet=wet, height=column * step + 18):
                def paint(s, t):
                    depth_px = t * height
                    if depth_px < step and not wet:
                        colour = surface
                    elif depth_px < 3 * step:
                        colour = look["soil"]
                    else:
                        colour = look["rock"]
                    return shade(colour, light, int(hash01(seed, int(s * 4), int(t * 9)) * 8) - 4)

                return paint

            canvas.box(
                (x, y),
                a,
                column * step + 18,
                lambda s, t, c=top, j=jitter: shade(c, 1.0, j),
                side(0.8),
                side(0.62),
            )
            prop = hash01(seed + 7, gx, gy)
            if not wet and level > sea_level + 1 and prop > 0.8:
                draw_prop(canvas, look, (x, y), a)
    return canvas.png()


def draw_prop(canvas, look, top, a):
    x, y = top
    kind = look["props"]
    flat = lambda c: lambda s, t: c
    lit = lambda c, k: lambda s, t: shade(c, k)

    def block(colour, size, height, lift):
        canvas.box(
            (x, y + a / 2 - size / 2 - lift),
            size,
            height,
            flat(colour),
            lit(colour, 0.8),
            lit(colour, 0.62),
        )

    if kind in ("trees", "palms"):
        block((112, 82, 52), 2, 14, 12)
        leaves = (58, 112, 58) if kind == "trees" else (92, 150, 70)
        block(leaves, 7 if kind == "trees" else 6, 7, 20)
    elif kind == "flowers":
        block((232, 210, 90) if x % 2 else (226, 120, 140), 2, 3, 3)
    elif kind == "vents":
        block((240, 140, 50), 3, 2, 1)
    elif kind == "crystals":
        block((190, 150, 255) if x % 2 else (120, 230, 240), 3, 12, 10)


for mod, items in MODS.items():
    (repo / "mods" / mod / "thumbnail.png").write_bytes(mod_thumbnail(mod, items))
for mod in CHARACTERS:
    (repo / "mods" / mod / "thumbnail.png").write_bytes(character_thumbnail(mod))
for game, look in GAMES.items():
    (repo / "games" / game / "thumbnail.png").write_bytes(game_thumbnail(game, look))

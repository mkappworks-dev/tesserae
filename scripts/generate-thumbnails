#!/usr/bin/env python3
"""Writes the 512 by 288 menu thumbnails of the demo Games and of the Mods listed in MODS, each as
thumbnail.png beside its mod.toml.

A Mod's thumbnail draws its own Materials as Voxels, textured from the art that
scripts/generate-mod-art wrote, so run that first. A Game's thumbnail is a small seeded island
drawn in the Game's colours. The images are original and generated here, so they are CC0 and their
source is this file. Output is deterministic, so a re-run changes no file.
"""

import pathlib
import struct
import zlib

WIDTH, HEIGHT = 512, 288
repo = pathlib.Path(__file__).resolve().parent.parent

# Mod id -> its textures, left to right.
MODS = {
    "timber": ["planks", "thatch"],
    "crystals": ["amethyst", "citrine", "aquamarine"],
    "hearth": ["ash", "lava"],
    "frost": ["snow", "ice", "packed_ice"],
}

# Game id -> sky (top, bottom), water, shore, ground bands from low to high, side soil and rock,
# sea level (0..1), and what stands on the ground.
GAMES = {
    "terra": dict(
        sky=((206, 214, 216), (168, 178, 180)),
        water=(56, 104, 122),
        shore=(214, 190, 132),
        bands=[(98, 150, 70), (78, 128, 60), (128, 126, 118), (236, 240, 242)],
        soil=(112, 78, 50),
        rock=(104, 104, 112),
        sea=0.36,
        props="trees",
        seed=11,
    ),
    "meadow": dict(
        sky=((222, 228, 206), (184, 196, 170)),
        water=(70, 120, 140),
        shore=(206, 196, 140),
        bands=[(124, 176, 78), (106, 162, 70), (94, 146, 66), (140, 160, 96)],
